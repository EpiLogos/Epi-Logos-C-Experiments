coordinate: "M2-1"
c_4_artifact_role: "base-view"
c_5_reflects: "[[M2-1]]"
c_3_projected_from: "neo4j://Bimba/M2-1"
c_3_projected_at: "2026-06-25"
c_0_source_coordinates: ["[[M2-1]]", "[[M2]]", "[[48-bases-cs-reflection-layer]]"]
filters:
  and:
    - 'coordinate.startsWith("M2-1")'
    - 'c_4_artifact_role == "map-index"'
views:
  - type: cards
    name: "M2-1 MEF lenses"
    image: c_1_symbol_image
    order:
      - coordinate
      - title
      - c_1_symbol_image
      - c_4_graph_node
      - c_0_source_coordinates
      - c_0_related_coordinates
    sort:
      - { property: coordinate, direction: ASC }
  - type: table
    name: "MEF lens inventory"
    group_by: c_0_source_coordinates
    order:
      - coordinate
      - title
      - c_4_graph_node
      - c_0_source_coordinates
      - c_0_related_coordinates
      - c_3_projected_at
    sort:
      - { property: coordinate, direction: ASC }
