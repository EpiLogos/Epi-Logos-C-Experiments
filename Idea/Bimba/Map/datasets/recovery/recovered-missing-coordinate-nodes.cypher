  `p_2_investigatory_alignment`: 'Corresponds to Position 5 in archetypal numbers: "Why" questions revealing ultimate purpose - logic serving liberation, understanding manifesting as wisdom',
  `s_4_cyclic_return`: 'This wisdom becomes the ground for new inquiry (return to 2.0)',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03'
