  SET n:MEFLens:ArticulationGroup
  SET n += {
  `c_0_core_nature`: 'Four as number of manifestation and stability - archetypal number of wholeness-in-matter (Jung\'s quaternity principle). Even number with Adam principle expressing maximum structural stability: four directions, four elements, four functions, four causes. The square as symbol of earthly completeness. Four enables comprehensive mapping - minimum for covering logical space (tetralemma), causal space, psychological space. First half of [4↔5] culminating oscillation - the CONTEXTUAL pole enabling transcendence.',
  `c_0_dual_aspect_nature`: 'Integrates top-down (transcendent) and bottom-up (emergent) causation',
  `c_0_essence`: 'Operates as fourth explicate position providing contextual ground - where cycle touches actuality and enables practical manifestation. Forms contextual pole of [4↔5] oscillation.',
  `c_0_operational_essence`: 'Operates as fourth explicate position providing contextual ground - where cycle touches actuality and enables practical manifestation. Forms contextual pole of [4↔5] oscillation.',
  `c_1_consciousness_structure`: 'Situated awareness - consciousness recognizing its embeddedness in specific time-place; the grounded, incarnate knowing',
  `c_1_description`: 'Four embodies principle of manifestation and completion. If three is dynamic process, four is stable achievement. Double dyad (2×2) creates matrix structure - all combinations of two binary distinctions. Four creates square (geometric perfection), cross (intersection of dimensions), and mandala (wholeness expressed in form). First number both even (stable) and composite (2×2), showing wholeness achieved through internal differentiation. Where cycle touches earth. CRITICAL: Four creates CONTEXTUAL CONDITIONS enabling five\'s transcendent realization - immanent finality making ultimate finality possible.',
  `c_1_internal_structure`: 'Four as Value 4 occupying Position 5 creates contextual/spatiotemporal dimension - "when/where" questions situate phenomena in specific time-place. First square number (2²), establishing exponential growth pattern. Tetrad as minimum for comprehensive coverage (four corners define space; four seasons define year). Contains potential for recursive nesting - every context can itself be contextualized infinitely via 4.0-4.5 structure. Forms CONTEXTUAL POLE of [4↔5] oscillation - the CONDITIONS without which TRANSCENDENCE (#5) cannot occur.',
  `c_1_key_principles`: ['Value/Position: Value 4 at Position 5 - contextual manifestation grounds in actuality', 'Adam Principle: Even number providing stable manifestation framework', 'Spatiotemporal Inquiry: "When and Where?" - situating in time and space', 'Quaternary Completeness: Minimum for comprehensive spatial-logical coverage', 'CONTEXTUAL FINAL CAUSE: Immanent conditions enabling transcendent purpose', 'Culminating Pole: First half of [4↔5] oscillation - context enabling transcendence', 'Recursive Nesting: Via "." operator, four contains all six positions infinitely', '4→5 Necessity: Cannot reach transcendence without contextual grounding'],
  `c_1_name`: 'Contextual field (when/where)',
  `c_1_nested_structure`: '#2-1-0-4.0 (context\'s potential) through #2-1-0-4.5 (context\'s purpose) creating first layer of 12-fold analysis',
  `c_1_operational_symbolics`: 'Square (stability and material perfection); cross (intersection of dimensions); mandala (four-fold wholeness); compass rose (four directions); four corners of earth',
  `c_1_primary_designation`: 'Four - Grounding Tetrad as "When/Where" Investigation',
  `c_1_structure`: 'Four as Value 4 occupying Position 5 creates contextual/spatiotemporal dimension - "when/where" questions situate phenomena in specific time-place. First square number (2²), establishing exponential growth pattern. Tetrad as minimum for comprehensive coverage (four corners define space; four seasons define year). Contains potential for recursive nesting - every context can itself be contextualized infinitely via 4.0-4.5 structure. Forms CONTEXTUAL POLE of [4↔5] oscillation - the CONDITIONS without which TRANSCENDENCE (#5) cannot occur.',
  `c_2_adam_eve_principle`: 'Adam (even) - structural/stabilizing - maximum stability in manifestation',
  `c_2_architectural_function`: 'Fourth explicate position in mod6 cycle as contextual flowering - where abstract structure manifests in concrete form. Value 4 at Position 5 establishes spatiotemporal investigation: "WHEN and WHERE does this occur?" Four grounds cycle in actuality, enabling practical application. Forms CONTEXTUAL FINAL CAUSE - the immanent conditions necessary for transcendent purpose (#5) to actualize. SPECIAL NESTING: Via "." operator (4.0-4.5), four contains all six positions recursively. First pole of [4↔5] non-dual culmination.',
  `c_2_final_cause_bifurcation`: '',
  `c_2_has_nested_reflection`: true,
  `c_2_holographic_function`: 'Ensures every part contains information about the whole through relational embedding',
  `c_2_investigatory_mode`: 'WHEN/WHERE (context) - spatiotemporal inquiry situating phenomena',
  `c_2_nesting_capacity`: 'Special recursive property: 4.0 through 4.5 creates infinite dimensional nesting - every context contextualizable ad infinitum',
  `c_2_notion_page_id`: '1d2a4797-123c-813e-9ded-db06830d9b31',
  `c_2_recursive_nesting`: true,
  `c_2_twelve_fold_scaffolding`: 'The 6 sub-positions at .4, combined with the 6 primary positions, create the foundational 12-fold structure that resonates throughout the system',
  `c_2_uuid`: 'e1af3614-7c84-5af6-b57d-7001adc3715e',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Epistemic Compass: "When/Where" questions - contextual and situational inquiry', 'Grounding Practice: Manifesting abstract understanding in concrete form', 'Comprehensive Mapping: Using quaternary to ensure complete coverage', 'Mandala Construction: Four-fold symmetry as wholeness expression', 'Contextual Nesting: Recognizing infinite recursion via 4.x structure', 'Practical Application: Where theory meets practice (earth)', 'Cross-Cultural Analysis: Four as universal structural principle'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 4,
  `c_4_subsystem`: 2,
  `c_5_oscillatory_relationship`: '[4↔5] CULMINATING NON-DUALITY: Four (contextual/immanent) and Five (transcendent/ultimate) form second oscillating pair mirroring [0↔1]. Four creates CONDITIONS necessary for five\'s PURPOSE to manifest. Final cause BIFURCATES: Proximate telos (where/when actualization occurs) at #4, Ultimate telos (why it all matters) at #5. Cannot have transcendence without context, cannot understand context without glimpsing transcendence. This oscillation IS realization occurring.',
  `c_5_resonances`: ['Von Franz: Four as wholeness in matter, realization principle', 'Jung: Quaternity as archetype of completeness, stability, earthly order', 'Four Elements: Earth-Water-Air-Fire as material substrate', 'Four Directions: N-S-E-W as spatial orientation framework', 'Four Functions: Sensation-Feeling-Thinking-Intuition (Jung)', 'Aristotle: Four causes (with final cause bifurcating at 4/5)', 'Tetralemma: Is, Is-Not, Both, Neither as logical space'],
