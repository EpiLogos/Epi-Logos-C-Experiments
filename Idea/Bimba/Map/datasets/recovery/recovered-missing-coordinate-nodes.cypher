MERGE (n:Bimba {coordinate: 'S\''})
  SET n:Stack
  SET n += {
  `artifact_kind`: 'vault_canvas',
  `c_0_core_nature`: 'Prime/inverted coordinate branch for QL-aware reflective and agentic surfaces across S0\' through S5\'.',
  `c_1_description`: 'Prime/inverted coordinate branch for QL-aware reflective and agentic surfaces across S0\' through S5\'.',
  `c_1_form`: 'Idea/Bimba/World/Types/Coordinates/S/S\'/S\'.canvas',
  `c_1_name`: 'S\' Reflective Technical Stack',
  `c_1_structure`: '{"authority_spec":"docs/specs/S/S-STACK-INTEGRATION.md","layer_name":"reflective-technical-stack","promotion_contract":"s-branch-live-promotion-v1"}',
  `c_4_artifact_role`: 'definition',
  `c_4_family`: 'S',
  `c_4_layer`: 'S-prime-root',
  `content_hash`: 'sha256:f6c01e1c8803cf49444220df292b23a3cac9bbbff44dbf44b7a717140bdd4d61',
  `coordinate_axis`: 'prime',
  `coordinate_depth`: 1,
  `coordinate_prefix`: 'S\'',
  `promotion_source`: 'pi_agent',
  `s_0_owned_by_coordinate`: 'M5-2',
  `s_4_function_role`: 'Inverted Stack coordinate namespace root',
  `sync_status`: 'm5_thread_integrated',
