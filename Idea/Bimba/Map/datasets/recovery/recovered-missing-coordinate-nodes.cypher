MERGE (n:SynthesisAttribute {coordinate: 'L0-3\''})
  SET n:MEFLens:ArticulationGroup
  SET n += {
  `c_0_core_nature`: 'Three as transcendent function at archetypal-numerical level - resolves tension of two not by choosing one side but by generating tertium quid (third thing) transcending and including both poles. Odd number bearing Eve principle (generative/dynamic) - supremely creative, manifesting as holy trinity across traditions. First number creating stable form (triangle as minimum polygon). Second position in (2-3) explicate dyadic core - the synthesis following method.',
  `c_0_essence`: 'Operates as third explicate position providing mediating structure - synthesis enabling movement from duality to integrated complexity. Completes (2-3) core.',
  `c_0_operational_essence`: 'Operates as third explicate position providing mediating structure - synthesis enabling movement from duality to integrated complexity. Completes (2-3) core.',
  `c_1_consciousness_structure`: 'Mediating awareness - consciousness as synthesizing agent holding opposites; neither subject nor object but their relation',
  `c_1_description`: 'Three embodies principle of mediation and transformation. Not static balance but dynamic resolution generating novelty. Three creates depth (third dimension), time (past-present-future), and meaning (signifier-signified-sign). Mediator between one (unity) and two (division) - neither collapsing back to oneness nor remaining stuck in duality. Jung\'s transcendent function operates here: holding opposites without premature resolution until third term emerges. Synthesis that is more than sum of parts. Completes (2-3) core preparing for [4↔5] oscillation.',
  `c_1_internal_structure`: 'Three as Value 3 occupying Position 4 creates mediating/agential dimension - "who" and "whereby" questions arise when we recognize synthesizing agent. First truly odd prime (1 is unit, 2 is even), establishing pattern of odd-prime generation. Triangle as first closed figure (stable) yet dynamic (pointing upward). Triad contains dialectical structure within itself: thesis (1) + antithesis (2) = synthesis (3). Forms second half of (2-3) explicate core - MEDIATION completing METHOD\'s work.',
  `c_1_key_principles`: ['Value/Position: Value 3 at Position 4 - mediating agency emerges', 'Eve Principle: Odd number expressing generative power of synthesis', 'Psychological/Agential Inquiry: "Who does this?" and "Whereby (through what)?"', 'Transcendent Function: Holding contradiction generates third term', 'Triadic Structure: Minimum for process (beginning-middle-end) and meaning', 'Developmental Completion: Second half of (2-3) core before [4↔5] oscillation', 'Synthesis Preparing Context: Three\'s resolution enables four\'s grounding'],
  `c_1_name`: 'Mediating identity (who)',
  `c_1_operational_symbolics`: 'Triangle (stability and upward movement); trident (three-pronged power); trinity knot (threefold unity); three-phase process (beginning-middle-end)',
  `c_1_primary_designation`: 'Three - Synthetic Triad as "Who/Whereby" Investigation',
  `c_1_structure`: 'Three as Value 3 occupying Position 4 creates mediating/agential dimension - "who" and "whereby" questions arise when we recognize synthesizing agent. First truly odd prime (1 is unit, 2 is even), establishing pattern of odd-prime generation. Triangle as first closed figure (stable) yet dynamic (pointing upward). Triad contains dialectical structure within itself: thesis (1) + antithesis (2) = synthesis (3). Forms second half of (2-3) explicate core - MEDIATION completing METHOD\'s work.',
  `c_2_adam_eve_principle`: 'Eve (odd) - generative/dynamic - creates resolution through synthetic power',
  `c_2_architectural_function`: 'Third explicate position in mod6 cycle as mediating structure - psychological/ontological dimension where synthesis occurs. Value 3 at Position 4 establishes agential investigation: "WHO/WHEREBY does this happen?" Triad enables movement from dyadic oscillation to triadic spiraling (thesis → antithesis → synthesis → new thesis). Creates depth, time, and meaning itself. Second half of (2-3) developmental core, completing linear progression before [4↔5] culminating oscillation begins.',
  `c_2_investigatory_mode`: 'WHO/WHEREBY (agent) - psychological inquiry into mediating agency and means',
  `c_2_notion_page_id`: '1d2a4797-123c-8104-bd3e-c6c729e933c0',
  `c_2_uuid`: '54007f7c-8fd7-59ec-866e-66bcac644d43',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Epistemic Compass: "Who" questions - identifying agent and mediator', 'Whereby Logic: "Through what means?" - instrumental/mediating structures', 'Synthetic Thinking: Generating third options beyond either/or', 'Triangulation: Using three points to establish position/truth', 'Temporal Navigation: Past-present-future as meaningful sequence', 'Conflict Resolution: Transcendent function dissolving false dichotomies', 'Triadic Semiotics: Understanding meaning through three-term relations'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 3,
  `c_4_subsystem`: 2,
  `c_5_resonances`: ['Von Franz: Three as dynamic resolution, movement, and life principle', 'Hegel: Synthesis as aufheben - canceling, preserving, elevating simultaneously', 'Jung: Transcendent function generating third thing from opposite tensions', 'Christian Trinity: Three persons, one God - unity-in-distinction', 'Hindu Trimurti: Creator-Preserver-Destroyer as cosmic process', 'Peirce: Triadic semiotics - sign/object/interpretant as meaning-structure'],
  `c_5_systemic_resonance`: 'Mahamaya - the great measurer who gives form to the formless through divine proportion',
  `coordinate_axis`: 'prime',
  `coordinate_parent`: 'L0\'',
  `l_0_base_index_6`: 0,
