  `c_4_subsystem`: 2,
  `c_5_oscillatory_relationship`: '',
  `c_5_resonances`: ['Nagarjuna: Fourth lemma completing catuskoti', 'Pseudo-Dionysius: God beyond being and non-being', 'Meister Eckhart: Godhead beyond God', 'Wittgenstein: "Whereof one cannot speak..."', 'Buddhist Silence: Noble silence transcending positions', 'Negative Theology: Via negativa to the absolute', 'Archetypal Four: "When/Where" recognizing contextual limits'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L2',
  `l_0_base_index_6`: 2,
