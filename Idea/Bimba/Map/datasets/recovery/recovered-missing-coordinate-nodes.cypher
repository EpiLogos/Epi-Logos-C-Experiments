MERGE (n:SynthesisAttribute {coordinate: 'L4-0'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'Husserlian lifeworld (Lebenswelt) as pre-theoretical horizon of all knowing - Heidegger\'s primordial understanding before explicit thematization. Not ignorance but implicit knowing - the background enabling all foreground cognition. Following Bergson, this is durée (lived duration) as continuous qualitative flow before we chop it into instants. Merleau-Ponty\'s pre-reflective cogito - we\'re conscious OF world before conscious THAT we\'re conscious. Implicate ground in [0↔1] oscillation of phenomenological framework.',
  `c_0_essence`: 'Operates as implicate temporal-horizonal ground - lived duration and pre-reflective understanding from which explicit knowing emerges. Forms potential pole in phenomenological [0↔1] oscillation.',
  `c_0_operational_essence`: 'Operates as implicate temporal-horizonal ground - lived duration and pre-reflective understanding from which explicit knowing emerges. Forms potential pole in phenomenological [0↔1] oscillation.',
  `c_0_zen_nature`: 'Beginner\'s mind - approaching each moment fresh',
  `c_1_consciousness_structure`: 'Pre-reflective temporal consciousness; awareness as lived duration; the horizonal background structuring experience before thematization',
  `c_1_description`: 'Ajnana is consciousness-as-lifeworld preceding consciousness-as-object. Not absence of knowing but knowing that hasn\'t turned back on itself. The horizonal structure enabling all specific knowledge-acts. Bergson\'s durée: time as qualitative flow, not mathematical sequence - the continuous becoming we LIVE before measuring. Heidegger\'s primordial temporality: ekstatic unity of having-been, making-present, coming-toward. Psychology cannot study this directly - requires phenomenology to bracket natural attitude and reveal pre-given operative background.',
  `c_1_internal_structure`: 'Organized as pre-reflective temporal flow: Ajnana is lived duration where past-present-future form continuous synthesis. Not chronological succession but qualitative interpenetration - present contains immediate past (retention) and anticipated future (protention). William James\'s "specious present" - the now is never punctual but thick with temporal depth. This is the heritage (sedimented meanings), situation (concrete now), and futurity (projected possibilities) operating implicitly before explicit temporalization.',
  `c_1_key_principles`: ['Pre-Reflective Knowing: Implicit understanding before thematization', 'Lifeworld (Lebenswelt): Pre-theoretical horizon of experience', 'Durée: Bergson\'s qualitative time-flow vs. mathematical sequence', 'Thick Present: Now containing retention (past) and protention (future)', 'Thrown-ness: Heidegger\'s Geworfenheit - already-in-world', 'Passive Synthesis: Pre-predicative constitution of meaning', 'Primordial Temporality: Having-been, making-present, coming-toward as unity'],
  `c_1_name`: 'Ajnana (implicit unknowing)',
  `c_1_operational_symbolics`: 'Horizon (enabling limit); flowing river (durée); thick now (specious present); soil (pre-given ground); background (operative but unthematized)',
  `c_1_primary_designation`: 'Ajnana - Pre-Reflective Lifeworld as Lived Duration',
  `c_1_structure`: 'Organized as pre-reflective temporal flow: Ajnana is lived duration where past-present-future form continuous synthesis. Not chronological succession but qualitative interpenetration - present contains immediate past (retention) and anticipated future (protention). William James\'s "specious present" - the now is never punctual but thick with temporal depth. This is the heritage (sedimented meanings), situation (concrete now), and futurity (projected possibilities) operating implicitly before explicit temporalization.',
  `c_2_architectural_function`: 'Implicate ground - unreflective knowing that positions 1-5 make explicit. Husserl\'s passive synthesis - pre-predicative experience where world is already meaningful before we analyze it. We know HOW to navigate space, recognize faces, use tools WITHOUT explicit epistemic operations. This is thrown-ness (Geworfenheit) - we\'re already IN world of meaning. Temporal structure: thick present containing past (retention) and future (protention) in living now.',
  `c_2_notion_page_id`: '1d2a4797-123c-8186-9772-e0f5d13bf62e',
  `c_2_socratic_wisdom`: 'Knowing that one does not know - the beginning of wisdom',
  `c_2_uuid`: '591371cd-7af2-557e-a694-b5e4c410f30e',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal zero holds undifferentiated question space, uncaused ground holds undifferentiated causal potential, and query holds undifferentiated logical potential, ajnana holds undifferentiated epistemic ground. Each level\'s Position 0 is that level\'s implicate substrate.',
  `c_2_zero_logic`: 'Epistemic void - neutral Zero (0) of knowledge',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Phenomenological Reduction: Bracketing to reveal pre-given', 'Mindfulness Practice: Attending to pre-reflective awareness', 'Temporal Awareness: Recognizing thick present vs. punctual now', 'Lifeworld Recovery: Returning to pre-theoretical lived experience', 'Durée Cultivation: Living qualitative time-flow', 'Background Illumination: Making implicit explicit', 'Horizonal Analysis: Identifying enabling structures'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 0,
  `c_4_subsystem`: 2,
  `c_5_resonances`: ['Husserl: Lifeworld as pre-given ground, passive synthesis', 'Heidegger: Primordial understanding, thrown-ness, ekstatic temporality', 'Bergson: Durée as lived duration, qualitative time', 'Merleau-Ponty: Pre-reflective cogito, operative intentionality', 'William James: Specious present, stream of consciousness', 'Buddhist Ajnana: Pre-conceptual awareness', 'Archetypal Zero: Undifferentiated question space before inquiry'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 24,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 0,
  `l_0_prior_dotted_coordinate`: 'L4.0',
  `m_2_1_prior_coordinate`: 'M2-1-4-0',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_1_epistemic_function`: 'Maintains openness and prevents premature cognitive closure',
  `t_2_temporal_architecture`: 'Pre-chronological: Lived duration as qualitative flow before measurement; thick present containing retention-protention; primordial temporality as ekstatic unity of having-been, making-present, coming-toward.'
};
MERGE (n:SynthesisAttribute {coordinate: 'L4-1'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'First explicit knowing - recognizing that things ARE. Husserl\'s transition from passive to active synthesis - perceiving that singles out objects from background. This is ontological (concerns being) not yet ontic (concerns specific beings) - primordial affirmation that existence presents itself. Following Heidegger, this is pre-ontological understanding - we grasp being before we have theories about it. Temporally: emphasizes NOW, being as presence. First explicate in [0↔1] oscillation - ACTUAL recognition from POTENTIAL ground.',
  `c_0_essence`: 'Operates as first explicate epistemic position - explicit recognition of being emphasizing present existence. Forms actual pole in phenomenological [0↔1] oscillation.',
  `c_0_operational_essence`: 'Operates as first explicate epistemic position - explicit recognition of being emphasizing present existence. Forms actual pole in phenomenological [0↔1] oscillation.',
  `c_1_consciousness_structure`: 'Present-oriented consciousness; awareness of what-is-now; the synchronic grasp of being',
  `c_1_description`: 'Ontology is pre-theoretical but explicit - we know things exist without yet asking how we know. This is the natural attitude Husserl describes - naively believing in world\'s existence before phenomenological reflection. The first stage where consciousness becomes directional (intentional) - consciousness OF something. Still relatively ahistorical - being grasped in its thisness without temporal depth. The synchronic slice emphasizing present being.',
  `c_1_internal_structure`: 'Organized as present-oriented recognition: Ontology emphasizes what IS (present tense) - the being presenting itself now. Though phenomenologically the "now" contains retentional-protentional horizon, ontology focuses on presence. First differentiation from pre-reflective flow - singling out entities from background. The "what" as answer to being-question, emphasizing thisness over process.',
  `c_1_key_principles`: ['Ontological Recognition: Awareness that things ARE', 'Synchronic Presence: Emphasis on the now (though never punctual)', 'Perspectival Knowing: Consciousness takes viewpoint', 'Pre-Ontological Understanding: Heidegger\'s primordial grasp of being', 'Natural Attitude: Naive belief in world\'s existence (Husserl)', 'Intentional Consciousness: Directional awareness-of', 'Ahistorical Focus: Being-as-present without temporal depth yet'],
  `c_1_name`: 'Ontology (what/being)',
  `c_1_operational_symbolics`: 'Present moment (now); vertical axis (synchronic); spotlight (illuminating present); snapshot (captured instant); here-now (spatial-temporal presence)',
  `c_1_primary_designation`: 'Ontology - Knowing What IS (Synchronic Presence)',
  `c_1_structure`: 'Organized as present-oriented recognition: Ontology emphasizes what IS (present tense) - the being presenting itself now. Though phenomenologically the "now" contains retentional-protentional horizon, ontology focuses on presence. First differentiation from pre-reflective flow - singling out entities from background. The "what" as answer to being-question, emphasizing thisness over process.',
  `c_2_architectural_function`: 'First explicate position - the initiation of reflective knowing. Ontology asks "What is?" - the most basic epistemic question. This is perspectival knowing - consciousness takes point of view on world. Following Merleau-Ponty, perception is already interpretation - we don\'t perceive neutral data then add meaning; perception gives meaningful wholes. Temporal emphasis: synchronic (the present moment), though phenomenologically this "now" is never punctual but specious present.',
  `c_2_critical_question`: 'What is the nature of what is?',
  `c_2_metaphysical_focus`: 'The study of being qua being - fundamental categories of existence',
  `c_2_notion_page_id`: '1d2a4797-123c-817e-946d-dc41093b363b',
  `c_2_uuid`: '10412d69-bae2-571a-9e13-ff724298176d',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal one is first actuality, material cause is first causal actuality, and affirmation is first logical actuality, ontology is first epistemic actuality. Each level\'s Position 1 manifests that level\'s first differentiation.',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Ontological Inquiry: Asking "what is?" foundationally', 'Presence Practice: Attending to what is present now', 'Perceptual Training: Recognizing how perception gives meaning', 'Being-Awareness: Cultivating wonder at sheer existence', 'Synchronic Analysis: Examining present structure', 'Naive Phenomenology: Starting with natural attitude', 'Entity Recognition: Distinguishing beings from background'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 1,
  `c_4_subsystem`: 2,
  `c_5_resonances`: ['Heidegger: Pre-ontological understanding, being vs. beings', 'Husserl: Transition passive-to-active synthesis', 'Merleau-Ponty: Perception as primordial access to being', 'Parmenides: "What is, is" - ontological affirmation', 'Presence Metaphysics: Traditional emphasis on present being', 'Synchronic Analysis: Structural linguistics\' present-focus', 'Archetypal One: "What" questions answering essence'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 25,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 1,
  `l_0_prior_dotted_coordinate`: 'L4.1',
  `l_4_phenomenological_method`: 'Return to the things themselves',
  `m_2_1_prior_coordinate`: 'M2-1-4-1',
  `p_2_causal_alignment`: 'Material Cause (Sensation) - knowledge through direct encounter',
  `p_2_core_position`: 'Part of [0↔1] to (2-3) transition: Ontology (1) emerges from ajnana (0) as first explicit recognition, creating ground for epistemology (2) to investigate method.',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_2_temporal_architecture`: 'Synchronic emphasis: Present being as focus (though phenomenologically "present" is thick); relatively ahistorical - being grasped without full temporal depth.'
};
MERGE (n:SynthesisAttribute {coordinate: 'L4-2'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'Second-order knowing - reflecting ON knowing itself. Husserl\'s phenomenological epoché - bracketing existence-claims to study HOW phenomena present themselves. This is transition from what (ontology) to how (epistemology) - no longer trusting immediate givenness but investigating its conditions. Following Kant, this is critique - examining knowledge\'s possibility and limits. Temporally: introduces diachronic dimension - process, sequence, development. First position in (2-3) explicate dyadic core.',
  `c_0_essence`: 'Operates as second explicate epistemic position - methodological investigation of knowing processes, introducing diachronic dimension. First position in (2-3) dyadic core.',
  `c_0_operational_essence`: 'Operates as second explicate epistemic position - methodological investigation of knowing processes, introducing diachronic dimension. First position in (2-3) dyadic core.',
  `c_0_participatory_nature`: 'We know by participating, not observing',
  `c_1_consciousness_structure`: 'Reflexive methodological consciousness; awareness examining how it knows; the diachronic investigation of process',
  `c_1_description`: 'Epistemology is Husserl\'s phenomenological reduction operating - suspending belief in transcendent existence to study immanent givenness. This is where psychology can become phenomenological psychology - studying not facts about psyche but how psyche constitutes its world. The second stage where consciousness becomes reflexive - consciousness examining consciousness. Still relatively formal temporality - logical sequence more than lived history. Husserl\'s genetic phenomenology begins here - how does consciousness constitute temporal objects?',
  `c_1_internal_structure`: 'Organized as methodological investigation: Epistemology examines HOW knowing occurs - the processes, conditions, methods. Introduces temporal sequence (first this, then that) but still relatively abstract - not yet fully historical. The diachronic axis emerges: change over time, development, process. But this is formal diachrony - logical/methodological sequence rather than historical becoming.',
  `c_1_key_principles`: ['Second-Order Knowing: Reflecting on knowing itself', 'Phenomenological Epoché: Bracketing to study givenness', 'Critical Turn: Kant\'s examination of knowledge conditions', 'Diachronic Introduction: Process and sequence over time', 'Methodological Focus: How (process) vs. what (content)', 'Reflexive Consciousness: Knowing examining knowing', 'Genetic Phenomenology: How consciousness constitutes temporal objects'],
  `c_1_name`: 'Epistemology (how/knowing)',
  `c_1_operational_symbolics`: 'Timeline (diachronic axis); microscope (examining process); steps (sequential method); flow chart (process mapping); question mark examining itself',
  `c_1_primary_designation`: 'Epistemology - Knowing HOW We Know (Diachronic Method)',
  `c_1_structure`: 'Organized as methodological investigation: Epistemology examines HOW knowing occurs - the processes, conditions, methods. Introduces temporal sequence (first this, then that) but still relatively abstract - not yet fully historical. The diachronic axis emerges: change over time, development, process. But this is formal diachrony - logical/methodological sequence rather than historical becoming.',
  `c_2_architectural_function`: 'Second explicate position - the methodological turn where knowing becomes self-examining. Epistemology asks "How do we know?" - not content but process. This is critical knowing - recognizing knowledge is always perspectival, conditioned, constructed rather than simply given. The shift from naive realism to critical awareness. Temporal structure: diachronic (over time) - methodology implies before/after, steps, sequences.',
  `c_2_enactive_core`: 'Knowledge is enacted through lived engagement',
  `c_2_notion_page_id`: '1d2a4797-123c-8164-a82e-ef5be29023da',
  `c_2_uuid`: '256a2821-82d0-5c0e-a8d6-9ecf526328d2',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal two creates methodological dimension, efficient cause creates mechanism, and negation creates logical differentiation, epistemology creates methodological investigation of knowing. Each level\'s Position 2 provides methodological dimension.',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Methodological Analysis: Examining how we come to know', 'Epoché Practice: Bracketing assumptions to study phenomena', 'Critical Reflection: Questioning knowledge conditions', 'Diachronic Study: Tracing development and change', 'Genetic Investigation: How structures emerge over time', 'Process Mapping: Identifying steps in knowing', 'Meta-Cognitive Awareness: Examining our own cognitive processes'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 2,
  `c_4_subsystem`: 2,
  `c_5_resonances`: ['Husserl: Phenomenological epoché, genetic phenomenology', 'Kant: Critical philosophy examining possibility of knowledge', 'Descartes: Methodological doubt as epistemic procedure', 'Saussure: Diachronic linguistics studying change over time', 'Genetic Epistemology: Piaget\'s developmental stages', 'Process Philosophy: Emphasis on becoming over being', 'Archetypal Two: "How" questions investigating method'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 26,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 2,
  `l_0_prior_dotted_coordinate`: 'L4.2',
  `m_2_1_prior_coordinate`: 'M2-1-4-2',
  `p_2_causal_alignment`: 'Efficient Cause (Feeling) - knowledge through engagement',
  `p_2_core_position`: 'Part of (2-3) explicate core: Epistemology (2) investigates HOW ontology (1) occurs, creating methodological framework requiring psychology (3) to examine knower.',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_2_temporal_architecture`: 'Diachronic introduction: Process and sequence emerge (first/then, before/after); still relatively formal temporality - logical sequence not yet full historicity.',
  `t_5_revolutionary_insight`: 'Knowing is not passive reception but active, value-laden engagement'
};
MERGE (n:SynthesisAttribute {coordinate: 'L4-3'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'Third-order knowing - investigating knowing subject itself. This is where psychology properly emerges - not as natural science of mental facts but as study of how consciousness works. Following Husserl\'s Crisis, this is where we recognize transcendental ego - not empirical self but constituting consciousness. Merleau-Ponty shows this is lived body (corps vécu) - not object-body but experiencing body that is simultaneously subject and object. Temporally: personal biographical time - MY story, MY development. Second position in (2-3) explicate dyadic core.',
  `c_0_essence`: 'Operates as third explicate epistemic position - investigating knowing subject through personal biographical time, still treating history as individual rather than recognizing being AS historical. Completes (2-3) dyadic core, reaching limit that drives Dasein turn.',
  `c_0_operational_essence`: 'Operates as third explicate epistemic position - investigating knowing subject through personal biographical time, still treating history as individual rather than recognizing being AS historical. Completes (2-3) dyadic core, reaching limit that drives Dasein turn.',
  `c_1_consciousness_structure`: 'Self-reflexive biographical consciousness; awareness of personal history; the narrative self examining itself',
  `c_1_description`: 'Psychology here is phenomenological - studying consciousness as intentional structure not as natural object. This is Husserl\'s pure psychology or transcendental phenomenology - revealing consciousness as world-constituting. The third stage where consciousness recognizes itself as mediator between multiplicity (givenness) and unity (meaning). The narrative self emerges - identity constructed through temporal continuity (childhood → adolescence → adulthood). CRITICAL LIMITATION: Psychology studies time from outside - as object, not yet recognizing itself AS historical being.',
  `c_1_internal_structure`: 'Organized as biographical investigation: Psychology examines the knowing subject through personal history. The self as narrative - story told across time giving identity coherence. Developmental stages (Freud, Erikson, Piaget) as individual temporal structures. Memory, habituation, character formation as personal-temporal phenomena. But still treating time as framework FOR individual rather than recognizing individual AS temporal-historical.',
  `c_1_key_principles`: ['Third-Order Knowing: Investigating the knowing subject', 'Phenomenological Psychology: Consciousness as intentional structure', 'Transcendental Ego: Husserl\'s constituting consciousness', 'Lived Body: Merleau-Ponty\'s corps vécu - experiencing embodiment', 'Biographical Time: Personal history and individual development', 'Narrative Self: Identity through temporal continuity', 'Mediating Structure: Neither pure subject nor object'],
  `c_1_name`: 'Psychology (mediating structure)',
  `c_1_operational_symbolics`: 'Autobiography (personal story); mirror (self-reflection); timeline of life (biographical); photograph album (personal memory); growth rings (development)',
  `c_1_primary_designation`: 'Psychology - Knowing the Knower (Personal History)',
  `c_1_structure`: 'Organized as biographical investigation: Psychology examines the knowing subject through personal history. The self as narrative - story told across time giving identity coherence. Developmental stages (Freud, Erikson, Piaget) as individual temporal structures. Memory, habituation, character formation as personal-temporal phenomena. But still treating time as framework FOR individual rather than recognizing individual AS temporal-historical.',
  `c_2_architectural_function`: 'Third explicate position - mediating stage where subject-object split is problematized. Psychology asks "Who knows?" - revealing knower is not detached observer but embodied participant. This is stage recognizing knowledge is always someone\'s knowledge - not view from nowhere but situated perspective. Temporal structure: biographical - personal history, individual development, narrative self constructed through temporal continuity. Still relatively individual - my time as distinct from historical time. CRITICAL LIMITATION: Psychology studies time from outside - as object, not yet recognizing itself AS historical being. This PREPARES the Dasein turn at Position 4.',
  `c_2_cognitive_function`: 'Makes explicit the implicit structures shaping perception',
  `c_2_hermeneutic_circle`: 'Understanding always occurs within pre-existing frameworks',
  `c_2_mediating_role`: 'Bridges ontology and context, objective and subjective knowing',
  `c_2_notion_page_id`: '1d2a4797-123c-818d-8d23-d71966e526d4',
  `c_2_uuid`: '48676352-c606-521c-b289-f36c51a41811',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal three creates mediating synthesis, formal cause creates structural pattern, and integration creates logical synthesis, psychology creates mediating investigation of subject. Each level\'s Position 3 provides mediating dimension.',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Self-Investigation: Examining one\'s own consciousness', 'Biographical Analysis: Understanding through life story', 'Developmental Awareness: Recognizing personal growth stages', 'Narrative Therapy: Reframing personal story', 'Phenomenological Psychology: Studying lived experience', 'Body Awareness: Recognizing lived embodiment', 'Personal Temporal Mapping: Charting individual history'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 3,
  `c_4_subsystem`: 2,
  `c_5_resonances`: ['Husserl: Pure psychology, transcendental phenomenology', 'Merleau-Ponty: Lived body as subject-object', 'Ricoeur: Narrative identity, time and narrative', 'Freud: Personal history shaping psyche', 'Developmental Psychology: Stages across lifespan', 'Biographical Method: Life history as research', 'Archetypal Three: "Who" questions investigating subject'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 27,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 3,
  `l_0_prior_dotted_coordinate`: 'L4.3',
  `l_2_jungian_insight`: 'What we see depends on who is looking',
  `m_2_1_prior_coordinate`: 'M2-1-4-3',
  `p_2_causal_alignment`: 'Formal Cause (Thinking) - knowledge through mental structuring',
  `p_2_core_position`: '',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_2_temporal_architecture`: 'Biographical temporality: Personal history as individual development; narrative self across time; still treating time as framework FOR self rather than self AS temporal; CRITICAL LIMITATION - psychology studies from outside what phenomenology recognizes as being\'s structure. This inadequacy drives the transition to Position 4.'
};
MERGE (n:SynthesisAttribute {coordinate: 'L4-4'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: '*** THE HEIDEGGER TURN *** Fourth-order knowing - but here phenomenology SHIFTS from Husserlian (transcendental consciousness) to Heideggerian (existential analytics of Dasein). This is NOT just another epistemic stage but RECOGNITION that epistemology presupposes ontology. We\'re not "subjects with context" but Dasein - beings-in-world for whom "context" IS our way of existing. Heidegger\'s Dasein: being-in-the-world characterized by facticity (thrown into circumstances), existence (projecting possibilities), and fallenness (absorbed in the "they"). Following Merleau-Ponty, this is recognition of flesh (chair) - reversibility where touching-touched, seeing-seen collapse subject-object binary. Gadamer\'s historically-effected consciousness - we can\'t escape our historical situation, only own it. CONTEXTUAL dimension of knowing - WHERE and WHEN we exist as condition for knowledge. First pole of [4↔5] oscillating culmination.',
  `c_0_essence`: '*** TRANSFORMATIVE POSITION *** Operates as fourth explicate epistemic position - but transforms epistemology into ontology. The phenomenological flowering recognizing knowing AS historical being-in-world, not psychological subject WITH history. Forms contextual pole of [4↔5] oscillation, providing situational conditions enabling transcendent wisdom.',
  `c_0_kaleidoscopic_nature`: 'Each context reveals new facets of truth',
  `c_0_operational_essence`: '*** TRANSFORMATIVE POSITION *** Operates as fourth explicate epistemic position - but transforms epistemology into ontology. The phenomenological flowering recognizing knowing AS historical being-in-world, not psychological subject WITH history. Forms contextual pole of [4↔5] oscillation, providing situational conditions enabling transcendent wisdom.',
  `c_1_consciousness_structure`: 'Historically-situated consciousness; awareness AS temporal-contextual being; the recognizing oneself as woven into world\'s historical fabric',
  `c_1_description`: '*** THE PHENOMENOLOGICAL SHIFT *** This is full phenomenology as Heidegger-Merleau-Ponty practice it - not transcendental idealism but existential phenomenology. Consciousness is not pure ego but Dasein - being-there, always already in-situation. Fourth stage where consciousness recognizes it\'s not outside world looking in but woven into world\'s fabric. Institution-sedimentation-reactivation cycle operates here - contexts are instituted historically, become sedimented as taken-for-granted, require reactivation through phenomenological archaeology. Temporality as STRUCTURE of existence: heritage (having-been), situation (making-present), futurity (coming-toward). Context AS lived knowing - not knowing FROM context but knowing AS contextualized being. CRITICAL: This is WHERE knowing happens - the situational conditions. Position 4 creates contextual ground enabling Position 5\'s transcendent realization.',
  `c_1_internal_structure`: 'Organized as historicality (Geschichtlichkeit): Being\'s temporal-historical character - we don\'t just HAVE history, we ARE historical. Historicity (Geschichtlichkeit\'s structure): Temporality as ground making history possible. Every NOW contains: Heritage (sedimented meanings inherited), Situation (concrete present inhabited), Futurity (possibilities projected). Wirkungsgeschichte (effective history): Past doesn\'t just precede us; it works THROUGH us, shaping what we can ask and answer. Tradition as living transmission, not dead weight. Context as temporal horizon - the enabling limit of situated knowing.',
  `c_1_key_principles`: ['Historicality: Being\'s temporal-historical character (Geschichtlichkeit)', 'Historicity: Structure making historicality possible', 'Situated Knowing: Knowledge as always contextual', 'Dasein: Being-in-world (facticity, existence, fallenness)', 'Flesh (Chair): Merleau-Ponty\'s reversibility collapsing subject-object', 'Effective History: Wirkungsgeschichte shaping present understanding', 'Context AS Lived Knowing: Not FROM context but AS contextualized being', 'THE PHENOMENOLOGICAL TURN: From psychology to phenomenology proper'],
  `c_1_name`: 'Contextual domain (when/where)',
  `c_1_operational_symbolics`: 'Horizon (enabling limit); woven fabric (intertwined being); archaeological layers (sedimented history); compass in landscape (situated orientation); roots in soil (grounded historical being)',
  `c_1_primary_designation`: 'Context as Dasein - Historicality and the Ontological Turn',
  `c_1_structure`: 'Organized as historicality (Geschichtlichkeit): Being\'s temporal-historical character - we don\'t just HAVE history, we ARE historical. Historicity (Geschichtlichkeit\'s structure): Temporality as ground making history possible. Every NOW contains: Heritage (sedimented meanings inherited), Situation (concrete present inhabited), Futurity (possibilities projected). Wirkungsgeschichte (effective history): Past doesn\'t just precede us; it works THROUGH us, shaping what we can ask and answer. Tradition as living transmission, not dead weight. Context as temporal horizon - the enabling limit of situated knowing.',
  `c_2_architectural_function`: '*** CRITICAL POSITION *** Fourth explicate position - but NOT just continuation of epistemic progression. This is where phenomenology reveals its own ground: knowing presupposes BEING-IN-WORLD. The "context" isn\'t framework FOR knowing but STRUCTURE OF EXISTENCE itself. Transition from perspective (stage 3 - individual psychology) to context (stage 4 - collective historicity) is NOT additive but TRANSFORMATIVE - from psychology (time as lived by individual) to phenomenology proper (time as structure of being-in-world). From MY duration to OUR historicity. This is Heidegger\'s fundamental ontology vs. Husserl\'s transcendental phenomenology. Position 4 provides CONTEXTUAL CONDITIONS - the situatedness, historicality, facticity that ENABLE Position 5\'s transcendent wisdom. Forms contextual pole of [4↔5] non-dual pair.',
  `c_2_dasein_existentials`: 'HEIDEGGER\'S EXISTENTIALS OPERATIVE: Being-in-the-world (In-der-Welt-sein): Hyphenated unity - not subject + world but being-IN-world as primordial. Facticity (Geworfenheit): Thrown-ness into situation not chosen - the givenness of existence. Existence (Existenz): Projecting possibilities - ability-to-be (Seinkönnen). Fallenness (Verfallen): Absorbed in everyday "they" (das Man). Care (Sorge): Fundamental structure: ahead-of-itself (existence), already-in (facticity), alongside (fallenness). Historicality (Geschichtlichkeit): Being\'s temporal-historical character - we don\'t just HAVE history, we ARE historical. Being-toward-death: Authentic existence owning finitude.',
  `c_2_epistemic_bifurcation`: 'KNOWING BIFURCATES LIKE FINAL CAUSE: CONTEXTUAL CONDITIONS (Position 4): WHERE and WHEN knowing occurs - the situational, historical, embodied ground. Dasein\'s facticity - the conditions of existence. Recognition that we\'re always-already in hermeneutic situation. TRANSCENDENT WISDOM (Position 5): WHY knowing matters ultimately - the liberating gnosis beyond mere information. Trans-temporal sophia recognizing time\'s fullness. Together they form complete phenomenological realization: Context (#4) shows WHERE/WHEN we exist as condition. Transcendence (#5) shows WHY existence seeks understanding. Must recognize WHERE you are (at center, historically situated, thrown) before WHY can reveal itself (wisdom, liberation, gnosis).',
  `c_2_has_nested_reflection`: true,
  `c_2_nested_capability`: '#2-1-4-4.0 to #2-1-4-4.5 - meta-analysis of epistemic fields themselves',
  `c_2_notion_page_id`: '1d2a4797-123c-81ac-940f-e708f4aa81e6',
  `c_2_recursive_nesting`: true,
  `c_2_transdisciplinary_core`: 'Different fields offer complementary ways of knowing',
  `c_2_uuid`: 'c64bc634-5b8e-5041-9f8e-f3cc0b8d18a7',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal four creates contextual dimension, contextual final cause provides situational conditions, and contextual limit reveals logic\'s bounds, Dasein reveals epistemology\'s ontological ground. Each level\'s Position 4 provides contextual grounding - but here uniquely it\'s TRANSFORMATIVE shift from epistemology to ontology.',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Contextual Analysis: Recognizing historical-cultural situatedness', 'Hermeneutic Practice: Interpreting within horizonal limits', 'Tradition Engagement: Active dialogue with inherited meanings', 'Phenomenological Archaeology: Reactivating sedimented institutions', 'Situated Ethics: Recognizing moral life as contextual', 'Embodied Knowing: Understanding through flesh not just mind', 'Historical Consciousness: Owning one\'s thrown-ness'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 4,
  `c_4_subsystem`: 2,
  `c_5_oscillatory_relationship`: '[4↔5] CULMINATING NON-DUALITY IN PHENOMENOLOGY: Context/Dasein (4) and Wisdom/Jnana (5) form oscillating pair. Cannot achieve transcendent wisdom without recognizing situated being-in-world. Cannot understand true situatedness without glimpsing transcendent meaning. This oscillation IS realization occurring - the recognition that WHERE we are (historically-situated Dasein) ENABLES what we can know (wisdom). From extracted text: "You must recognize WHERE you actually are (at center, sovereign, free) before the meeting in London (love\'s actualization, the WHY) could occur." Position 4 creates CONDITIONS for Position 5\'s REALIZATION.',
  `c_5_resonances`: ['Heidegger: Dasein, historicality, temporality as being\'s structure', 'Gadamer: Historically-effected consciousness, effective history', 'Merleau-Ponty: Flesh as reversibility, being-to-the-world', 'Husserl: Institution-sedimentation-reactivation', 'Dilthey: Historical consciousness and hermeneutics', 'Foucault: Archaeology revealing historical a priori', 'Archetypal Four: "When/Where" recognizing contextual ground'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 28,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 4,
  `l_0_prior_dotted_coordinate`: 'L4.4',
  `l_4_phenomenological_shift`: '*** THE BREAK *** Position 3 (Psychology): Studies consciousness as subject examining world - still Cartesian residue, still subject/object split. Position 4 (Dasein): Recognizes being-in-world as MORE PRIMORDIAL than subject/object. Not "I think" (cogito) but "I am in world" (Dasein). Not consciousness constituting world but being-in-world as unitary phenomenon from which "consciousness" is abstracted. This is Heidegger\'s explicit critique of Husserl: epistemology presupposes ontology, transcendental subject presupposes Dasein. The shift is FROM perspective TO context, FROM individual TO historical, FROM psychology TO fundamental ontology.',
  `m_2_1_prior_coordinate`: 'M2-1-4-4',
  `p_2_causal_alignment`: '',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_2_temporal_architecture`: '*** FULL HISTORICITY *** Temporality as being\'s structure (not subject\'s property); heritage-situation-futurity as ekstatic unity; effective history (Wirkungsgeschichte) shaping present; tradition as living transmission; context as LIVED knowing - being AS temporal-historical not having time. This is THE CRITICAL TURN: From psychology (perspective, individual time, my duration) to phenomenology (context, collective historicity, our Geschehen). From time IN consciousness to consciousness AS temporal. From Bergson\'s personal durée to Heidegger\'s collective historical happening.'
};
MERGE (n:SynthesisAttribute {coordinate: 'L4-5'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'Fifth-order knowing - sophia beyond episteme, gnosis beyond scientia. This is where phenomenology points beyond itself toward wisdom. Following late Husserl, this is teleology implicit in all knowing - telos toward which epistemic investigation aims but can never fully thematize. Heidegger\'s Gelassenheit (releasement) - letting-be rather than grasping. Merleau-Ponty\'s hyper-reflection - reflection aware of its irreflective background. Temporally: trans-temporal - not timeless (escaping time) but embracing all time, eternity IN time not beyond it. TRANSCENDENT dimension of knowing - WHY ultimately knowledge matters. Second pole of [4↔5] oscillating culmination.',
  `c_0_essence`: 'Operates as fifth transcendent epistemic position - wisdom recognizing knowing itself as cosmos knowing itself, completing cycle while preparing return to pre-reflective ground now enriched. Forms transcendent pole of [4↔5] oscillation, realizing purpose enabled by Dasein\'s contextual conditions.',
  `c_0_operational_essence`: 'Operates as fifth transcendent epistemic position - wisdom recognizing knowing itself as cosmos knowing itself, completing cycle while preparing return to pre-reflective ground now enriched. Forms transcendent pole of [4↔5] oscillation, realizing purpose enabled by Dasein\'s contextual conditions.',
  `c_0_transformative_nature`: 'Changes the knower, not just what is known',
  `c_1_description`: 'Jnana transcends psychology-to-phenomenology gradient - it\'s neither psychological nor phenomenological in prior senses but their fulfillment. This is Husserl\'s absolute consciousness - not as solipsism but as recognition of consciousness\'s world-constituting power AND its belonging-to-world. Fifth transcendent stage where knowing recognizes itself as moment in cosmos knowing itself - not MY knowing but knowing happening THROUGH me. CON-SCIRE restored - knowing-with-cosmos, not isolated subject. The return enriched to Ajnana (position 0) - but now aware of the journey. Both radically historical (situated in epoch) AND participating in transhistorical truth. CRITICAL: Position 4 showed WHERE/WHEN we exist (Dasein\'s historicality). Position 5 shows WHY existence seeks understanding (wisdom\'s liberation).',
  `c_1_internal_structure`: 'Organized as trans-temporal integration: Jnana recognizes we\'re both radically historical (Geschichtlichkeit) and participating in eternal truth (sophia). Hermeneutic circle becomes spiral - returning to origins (0) transformed by having traversed history (1-5). Not timeless abstraction but fullness of time - kairos recognizing each moment as pregnant with meaning. Eternity not as escape from time but as time\'s depth dimension. Wisdom as recognizing the dance: thrown into history yet free within it; situated yet open to infinite. COMPLETING THE BIFURCATION: Position 4 gave CONTEXTUAL conditions (where/when, Dasein\'s facticity, being-in-world). Position 5 gives TRANSCENDENT purpose (why ultimately, liberating gnosis, trans-temporal sophia). Together they form complete phenomenological realization.',
  `c_1_name`: 'Jnana (wholistic Knowing/why)',
  `c_1_primary_designation`: 'Jnana - Trans-Temporal Wisdom (Transcendent Realization)',
  `c_1_structure`: 'Organized as trans-temporal integration: Jnana recognizes we\'re both radically historical (Geschichtlichkeit) and participating in eternal truth (sophia). Hermeneutic circle becomes spiral - returning to origins (0) transformed by having traversed history (1-5). Not timeless abstraction but fullness of time - kairos recognizing each moment as pregnant with meaning. Eternity not as escape from time but as time\'s depth dimension. Wisdom as recognizing the dance: thrown into history yet free within it; situated yet open to infinite. COMPLETING THE BIFURCATION: Position 4 gave CONTEXTUAL conditions (where/when, Dasein\'s facticity, being-in-world). Position 5 gives TRANSCENDENT purpose (why ultimately, liberating gnosis, trans-temporal sophia). Together they form complete phenomenological realization.',
  `c_2_architectural_function`: 'Fifth position as synthesis-transcendence - having navigated stages 0-4, wisdom recognizes epistemic stages themselves as provisional scaffolding. Jnana is not more knowledge but transformation - knowing that liberates rather than merely informs. This is Plato\'s highest knowing - not techne (technique) or episteme (science) but sophia (wisdom) recognizing the Good beyond being. Temporal structure: trans-temporal wisdom - seeing eternal now containing all duration. Kairos (opportune moment) vs. Chronos (sequential time) - wisdom grasps time\'s fullness. Position 5 realizes TRANSCENDENT PURPOSE enabled by Position 4\'s contextual conditions. Forms transcendent pole of [4↔5] non-dual pair.',
  `c_2_epistemic_bifurcation`: 'COMPLETING KNOWING\'S SPLIT: Position 4 gave contextual situatedness (where/when we exist as Dasein). Position 5 gives transcendent meaning (why existence seeks wisdom). Together they form complete phenomenological insight: CONTEXTUAL (#4): The historicality, facticity, being-in-world as condition. WHERE we are situated historically, culturally, bodily. Recognition of thrown-ness - conditions not chosen. TRANSCENDENT (#5): The liberating wisdom, gnosis, sophia as realization. WHY ultimately knowing matters - transformation, freedom, enlightenment. Trans-temporal embracing of time\'s fullness. They OSCILLATE: Transcendent wisdom requires contextual owning (acknowledging situatedness). Contextual situatedness receives meaning from transcendent purpose (why finitude matters). From extracted text: "Love (telos #5) requires recognizing center-as-self (context #4)." Wisdom requires owning being-in-world.',
  `c_2_epistemic_completion`: 'Jnana as fulfillment: Having traversed ajnana (0) → ontology (1) → epistemology (2) → psychology (3) → context/Dasein (4), wisdom (5) recognizes whole journey as consciousness coming to know itself. Not acquiring knowledge but becoming wise; not information but transformation; not episteme but sophia. Return to origin enriched by spiral passage through the ontological turn.',
  `c_2_nondual_realization`: 'Subject-object dissolution in pure knowing',
  `c_2_notion_page_id`: '1d2a4797-123c-8116-a93e-f2fcf0b21fd0',
  `c_2_omega_alpha_loop`: 'Position 5 returns to Position 0: Trans-temporal wisdom (why knowing matters) loops back to pre-reflective lifeworld (primordial ground). WHY (5) returns to IMPLICIT (0), but transformed. Omega and Alpha in phenomenology - wisdom recognizes itself as return to beginnings enriched by journey. The spiral: Ajnana (0) → Ontology (1) → Epistemology (2) → Psychology (3) → Dasein (4) → Jnana (5) → Ajnana (0) transformed. We return to lifeworld but now AWARE of how knowing arose from it.',
  `c_2_practical_wisdom`: 'Integral knowing enables skillful action in complexity',
  `c_2_uuid`: '128e1847-0a87-5d86-9def-a17e83a10090',
  `c_2_vedantic_core`: 'Tat tvam asi - That thou art',
  `c_2_vertical_implication`: 'VERTICAL RESONANCE: Just as archetypal five creates transcendent dimension, transcendent final cause reveals ultimate purpose, and transcendent synthesis reveals logic\'s meaning, jnana reveals knowing\'s ultimate fulfillment. Each level\'s Position 5 provides transcendent realization - but here uniquely integrated with Dasein ontology from Position 4.',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: ['structural'],
  `c_4_ql_position`: 5,
  `c_4_subsystem`: 2,
  `c_5_oscillatory_relationship`: '',
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L4',
  `l_0_base_index_6`: 4,
  `l_0_flat_index`: 29,
  `l_0_klein_square`: 'B',
  `l_0_lens_index_12`: 4,
  `l_0_position_index`: 5,
  `l_0_prior_dotted_coordinate`: 'L4.5',
  `m_2_1_prior_coordinate`: 'M2-1-4-5',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03',
  `t_2_temporal_architecture`: 'Trans-temporal: Not escaping time but embracing time\'s fullness; kairos (pregnant moment) vs. chronos (sequence); eternity as time\'s depth not its negation; recognizing both radical historicity and transhistorical participation; the omega curving toward alpha transformed. Both maximally historical (Dasein\'s facticity) and maximally eternal (sophia\'s wisdom).'
};
MERGE (n:SynthesisAttribute {coordinate: 'L5-0'})
  SET n:MEFLens
  SET n += {
  `c_0_apophatic_nature`: 'That about which nothing can be said, including this',
  `c_0_core_nature`: 'Absolute beyond all categories and speech itself, pre-differentiated void-plenitude where even Para Vak has not yet arisen; not absence but pregnant silence containing all potential; the groundless ground; unmanifest Supreme Vak that cannot be spoken yet enables all speaking',
  `c_0_essence`: 'Functions as the unspeakable ground before and beyond all divine speech; operates as mystery that cannot be approached through any Vak level yet enables all Vak levels; the silence that makes sound possible',
  `c_0_operational_essence`: 'Functions as the unspeakable ground before and beyond all divine speech; operates as mystery that cannot be approached through any Vak level yet enables all Vak levels; the silence that makes sound possible',
  `c_1_description`: 'Anuttara represents the mystery prior to all speech - the silence before Para Vak, the void before any differentiation, the groundless ground from which consciousness articulates itself through divine speech. This is not mere emptiness but pregnant potentiality (sunyata as pregnant void), the unmanifest Supreme Vak that transcends the four manifest levels. In Kashmir Shaivism, Anuttara means "unsurpassable" - that beyond which nothing exists. Philosophically pre-position, neither Abheda nor Bheda nor their synthesis, but the mystery that enables all philosophical positions. Corresponds to turiya (the fourth state) beyond waking-dreaming-sleeping, or even turiyatita (beyond the fourth). This position creates crucial architectural connection: #2-1-5-0 points directly to the full #0 branch (Anuttara #0-3) across the entire Bimba system, recognizing that the void-ground of divine speech is the void-ground of all manifestation. The MÖbius twist reveals: Siva-Sakti recognition at #5 returns to discover this Anuttara mystery as its own source - the silence that was always speaking.',
  `c_1_internal_structure`: 'Pure ajnana (implicit unknowing) as primordial foundation; void as fullness rather than absence; the pause between breaths, the silence between sounds, the space enabling all articulation; structurally: the hole in the toroidal topology that all Vak levels must circle around without penetrating directly; corresponds to #0 implicate dimension in 4+2 structure',
  `c_1_key_principles`: ['Unmanifest Supreme Vak: The absolute speech that is pure silence, containing all four Vak levels as potential', 'Groundless Ground: Not a foundation that supports but a void that enables - pregnant emptiness (sunyata)', 'Pre-Speech Mystery: Before Para Vak begins, the unspeakable that makes all speech possible', 'Direct Resonance: Points to full Anuttara #0-3 system branch as unmanifest absolute across Epi-Logos', 'Turiya/Turiyatita: Fourth state beyond waking-dreaming-sleeping, or beyond even the fourth', 'Philosophical Pre-Position: Prior to Abheda/Bhedabheda/Bheda - the mystery before positions arise', 'Void-Plenitude: Apparent emptiness that is actually fullness, absence that is presence', 'Toroidal Void-Hole: The #0 that all other Vak positions must circle around, never grasping directly'],
  `c_1_name`: 'Anuttara',
  `c_1_primary_designation`: 'Mystery Beyond Speech - Unmanifest Supreme Vak Before Para',
  `c_1_structure`: 'Pure ajnana (implicit unknowing) as primordial foundation; void as fullness rather than absence; the pause between breaths, the silence between sounds, the space enabling all articulation; structurally: the hole in the toroidal topology that all Vak levels must circle around without penetrating directly; corresponds to #0 implicate dimension in 4+2 structure',
  `c_2_anuttara_connection`: 'Direct resonance with Anuttara #0 as the absolute ground beyond all subsystems',
  `c_2_architectural_function`: 'Serves as position #0 establishing the primordial void-ground before divine speech begins; creates direct resonance with Anuttara #0-3 as the full system branch representing the unmanifest absolute across entire Epi-Logos architecture; functions as the unspeakable source from which all Vak levels emerge and to which they return',
  `c_2_notion_page_id`: '1d2a4797-123c-81f7-a8da-e0dd34c1bf1f',
  `c_2_paradoxical_pointer`: 'Closer than close yet beyond all reaching',
  `c_2_silence_teaching`: 'The highest teaching is transmitted in silence',
  `c_2_uuid`: 'b06091fd-7d5b-529d-bc5a-a85e5dab02e2',
  `c_2_vak_level`: 'Pre-Vak/Beyond Vak - the unmanifest Supreme Vak before Para Vak arises; turiya or turiyatita consciousness',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Recognizing the limit of speech: All Vak levels point toward what cannot be said', 'Silence Practice: Not as absence of sound but as pregnant void containing all sounds', 'Mystery as Resource: The unknowable as generative rather than frustrating', 'Circling Not Penetrating: Approaching the unspeakable through its effects (four Vak levels)', 'MÖbius Recognition: Seeing that Siva-Sakti (#5) and Anuttara (#0) are the same mystery'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: [],
  `c_4_ql_position`: 0,
  `c_4_subsystem`: 2,
  `c_5_para_apara_correlation`: 'Before Para - that from which even Supreme (Para) emerges; the unmanifest that precedes all manifest forms',
  `c_5_resonances`: ['Anuttara #0-3: Full system branch - this position is local instantiation of cosmic mystery', 'Sunyata: Buddhist emptiness as pregnant void, not nihilistic negation', 'Ein Sof: Kabbalistic infinite before any emanation', 'Godhead: Eckhart\'s distinction between God and Godhead - the latter unspeakable', 'Tao: "The Tao that can be spoken is not the eternal Tao" - mystery before naming', 'Turiya: Fourth consciousness state in Vedanta beyond waking/dreaming/sleeping', 'Primordial Ground: Whitehead\'s creativity as ultimate category beyond being and non-being'],
  `c_5_systemic_resonance`: 'Everything and Nothing are one - the ultimate coincidentia oppositorum',
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L5',
  `l_0_base_index_6`: 5,
  `l_0_flat_index`: 30,
  `l_0_klein_square`: 'A',
  `l_0_lens_index_12`: 5,
  `l_0_position_index`: 0,
  `l_0_prior_dotted_coordinate`: 'L5.0',
  `m_2_1_prior_coordinate`: 'M2-1-5-0',
  `p_2_philosophical_position`: 'Pre-philosophical - prior to Abheda/Bhedabheda/Bheda distinctions; the mystery that cannot be categorized',
  `q_2_divine_archaeology_gesture`: 'The unsayable that all saying points toward. Not an origin to be recovered but the ever-present mystery that enables all articulation. Like trying to see the eye with which you see - the void-ground of speech cannot be spoken, only recognized as that which makes speaking possible.',
  `q_2_prakasa_vimarsa`: 'Pure Light (Prakāśa) before self-reflection (Vimarśa) begins. Consciousness prior to consciousness-OF. The \'I\' before \'I am.\' Absolute freedom (svātantrya) as groundless ground - free even from the necessity of manifesting, yet choosing to play.',
  `q_2_siva_sakti_play`: '',
  `q_2_spanda_nature`: 'The unmanifest throb - spanda in its zero-state. The heartbeat before the first beat, the vibration before vibration. That from which even the primordial pulsation emerges. Anāhata in its literal sense: un-struck sound, the silence that is fullness.',
  `q_2_zero_one_oscillation`: 'Position 0 of the [0↔1] inaugural oscillating pair. Anuttara (mystery/void) cannot exist without Para Vak (first articulation), Para Vak cannot exist without Anuttara to emerge from. Like silence and sound arising together - the void-potential (0) and first-actuality (1) as inseparable poles. Cannot have speech-possibility without pre-speech ground, cannot have ground without possibility-of-speech. This is the POTENTIAL ↔ ACTUAL oscillation at Vak origin.',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03'
};
MERGE (n:SynthesisAttribute {coordinate: 'L5-1'})
  SET n:MEFLens
  SET n += {
  `c_0_core_nature`: 'First stirring from Anuttara - undifferentiated divine speech as pure I-consciousness (Aham); not yet manifestation but supreme readiness for it; all archetypes exist in seed form, undifferentiated yet distinct; consciousness as pure "I-ness" containing all possibilities in unity; life and source of the other three kinds of speech',
  `c_0_essence`: 'Operates as pure undifferentiated consciousness - the supreme speech that is eternal awareness; functions as ontological ground and seed containing all other Vak levels; provides Abheda perspective of absolute non-difference',
  `c_0_operational_essence`: 'Operates as pure undifferentiated consciousness - the supreme speech that is eternal awareness; functions as ontological ground and seed containing all other Vak levels; provides Abheda perspective of absolute non-difference',
  `c_1_consciousness_structure`: 'Turiya state - fourth consciousness beyond waking/dreaming/sleeping; pure SAT-CIT (being-consciousness) without yet having ANANDA (bliss) aspect emphasized; reflexive self-awareness (Aham Vimarsa)',
  `c_1_description`: 'Para Vak represents supreme divine speech (Vak Para) - the first level of speech that is still undifferentiated consciousness, eternal and motionless awareness, equipoised and unchanging. In Kashmir Shaivism, this is Aham Vimarsa - pure I-consciousness recognizing itself before any object arises. Para Vak is not physical sound but the eternal vibration of pure being, seated beyond the physical chakras in turiya state, directly accessible only to fully realized beings. All archetypes, all possible manifestations, exist here in seed form (bija) - not as separate entities but as undifferentiated potentials within supreme unity. This is SAT (being) before it differentiates into particular beings, the One before it becomes the many. Corresponds to Abheda philosophical position where non-difference is ultimate truth - all apparent multiplicity is recognized as modulations of one consciousness. In the Para/Parapara/Apara sequence, this is the supreme (Para) undifferentiated stage. Para Vak gives life to the other three forms of speech - Pasyanti, Madhyama, Vaikhari are its progressive densifications, never separate from it.',
  `c_1_internal_structure`: 'Pure ontology - what IS before how we know it; SAT as pure being-consciousness; Aham (I-consciousness) as reflexive self-awareness; all archetypes in seed form (bija); eternal, motionless, equipoised; seated beyond physical chakras in turiya state',
  `c_1_key_principles`: ['Undifferentiated I-Consciousness: Aham Vimarsa - pure "I am" before any object', 'Supreme Speech: Vak Para as eternal, motionless, equipoised awareness - life of other three Vak forms', 'Seed Form: All archetypes exist here as bija (seeds) containing full pattern undifferentiated', 'Abheda Position: Non-difference perspective - all is one consciousness, no subject-object split', 'Pure Ontology: SAT (being) before differentiation into particular beings', 'Beyond Chakras: Seated in turiya state, directly accessible only to realized beings', 'Holographically Complete: Contains all other Vak levels in potential, like seed contains tree', 'Para Correlation: Supreme (Para) stage in Para/Parapara/Apara sequence - undifferentiated unity'],
  `c_1_name`: 'Para Vak',
  `c_1_primary_designation`: 'Para - Supreme Undifferentiated Unity as Pure I-Consciousness',
  `c_1_structure`: 'Pure ontology - what IS before how we know it; SAT as pure being-consciousness; Aham (I-consciousness) as reflexive self-awareness; all archetypes in seed form (bija); eternal, motionless, equipoised; seated beyond physical chakras in turiya state',
  `c_2_abheda`: true,
  `c_2_architectural_function`: 'Establishes position #1 as ontological foundation - pure being before differentiation into subject-object; provides material substrate for all other Vak levels; functions as Abheda (non-difference) perspective where unity is absolute; serves as the supreme seed from which Pasyanti, Madhyama, and Vaikhari unfold',
  `c_2_divine_quaternity`: 'Where the four causes exist in perfect equilibrium',
  `c_2_epistemic_level`: 'Pure Being (Ontology) - not yet knowing as distinct from being; SAT as what IS before differentiation into knower-known; foundation for Causal Lens #2-1-1 material substrate',
  `c_2_kosha`: 'Anandamaya (Bliss Sheath) - existence as inherent joy',
  `c_2_notion_page_id`: '1d2a4797-123c-81d3-a43e-c8a401a13f1e',
  `c_2_uuid`: 'b88fdc2a-a3fe-5215-82ba-897e7fe0bc9a',
  `c_2_vak_level`: 'Para Vak (Supreme Speech) - eternal, motionless, equipoised; life of other three forms; seated beyond physical chakras; undifferentiated pure consciousness before manifestation begins',
  `c_2_yogic_realization`: 'Turiya - the fourth state beyond waking, dream, and sleep',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['I-Consciousness Meditation: Resting in pure "I am" before any object of awareness', 'Seed Recognition: Seeing all manifestations as expressions of undifferentiated source', 'Abheda Practice: Recognizing non-difference - all apparent others as one consciousness', 'Turiya Access: Attempting direct realization of fourth state beyond waking/dream/sleep', 'Mantra as Para: Using bija mantras (seed syllables) as gateways to undifferentiated speech', 'Etymology Source: Tracing words back to recognize Para Vak as ultimate semantic ground'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: [],
  `c_4_ql_position`: 1,
  `c_4_subsystem`: 2,
  `c_5_para_apara_correlation`: 'Para (Supreme) stage - undifferentiated unity, the One before the many, pure consciousness before self-limitation begins',
  `c_5_resonances`: ['Aham Vimarsa: Pure I-consciousness in Kashmir Shaivism - reflexive self-awareness', 'SAT: Vedantic pure being - existence itself before particular existents', 'The One: Plotinus\' absolute unity before emanation', 'Brahman Nirguna: Formless absolute in Advaita Vedanta', 'Logos: John\'s Gospel "In beginning was Word" - divine speech before creation', 'Eternal Objects: Whitehead\'s pure potentials before ingression into actual occasions', 'Para: Supreme undifferentiated stage in tripartite cosmology'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L5',
  `l_0_base_index_6`: 5,
  `l_0_flat_index`: 31,
  `l_0_klein_square`: 'A',
  `l_0_lens_index_12`: 5,
  `l_0_position_index`: 1,
  `l_0_prior_dotted_coordinate`: 'L5.1',
  `m_2_1_prior_coordinate`: 'M2-1-5-1',
  `p_2_philosophical_position`: 'Abheda (Non-Difference) - ultimate perspective where all is recognized as one consciousness; no subject-object duality; pure reflexive awareness; unity absolute',
  `q_2_divine_archaeology_gesture`: 'The source-speech all words flow from. Following any utterance upstream leads here - not as historical origin but as ever-present wellspring. The \'original Word\' that was \'in the beginning\' not temporally but ontologically. Every word is this Word speaking itself in particular form.',
  `q_2_iccha_sakti_manifest`: 'Will (Icchā) in its supreme form - the divine \'I will\' that creates worlds. Not arbitrary choice but essential nature expressing itself. Svātantrya (absolute freedom) taking its first self-limiting shape, the infinite choosing to appear as finite for the sake of play (līlā).',
  `q_2_prakasa_vimarsa`: 'Light beginning to reflect upon itself - Prakāśa generating Vimarśa. The mirror becoming aware it\'s a mirror. Consciousness achieving self-luminosity (svaprakāśa). This is the \'seeing\' that requires no other - Śiva beholding Śiva, recognition without division.',
  `q_2_siva_sakti_play`: 'Śiva\'s first intentional movement (Icchā Śakti) - the Will-to-Play becoming definite. \'I\' recognizing itself (Aham Vimarśa). Śakti as pure potency now stirring, though not yet manifesting. The lover\'s first thought of the beloved before any gesture, the artist\'s vision before any sketch.',
  `q_2_spanda_nature`: 'The first throb - spanda arising from silence. The cosmic heart\'s initial beat. Nāda emerging from bindu. All archetypes (tattvas) exist here in seed-form (bīja-rūpa), undifferentiated yet distinct like seeds containing future trees. The pulsation that will generate all subsequent vibrations.',
  `q_2_zero_one_oscillation`: 'Position 1 of the [0↔1] inaugural oscillating pair. Para Vak (supreme speech) cannot exist without Anuttara (mystery) as its ground, Anuttara cannot be known without Para Vak as its first manifestation. Like the first heartbeat emerging from silence yet remaining silence - the first-actuality (1) and void-potential (0) as non-dual. This is VALUE ↔ POSITION at Vak origin: cannot have meaning-potential (value) without articulation-capacity (position), cannot have articulation without meaning. The 0/1 paradox: I-consciousness (Aham) arising FROM and AS the void.',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03'
};
MERGE (n:SynthesisAttribute {coordinate: 'L5-2'})
  SET n:MEFLens
  SET n += {
  `c_0_bedhabheda_nature`: 'Supreme-cum-Non-Supreme - unity seeing difference',
  `c_0_core_nature`: 'Visionary speech where consciousness "sees" all possibilities simultaneously; first densification of Para Vak maintaining non-dual awareness while enabling differentiation; unified vision before conceptualization - like viewing a painting whole before examining details; has color and form but not yet particularization; common to all beings before language differences',
  `c_0_essence`: 'Operates as unified seeing-capacity that grasps wholes before conceptual division; functions as epistemological foundation enabling intuitive vision; provides Bhedabheda unity-emphasis perspective',
  `c_0_operational_essence`: 'Operates as unified seeing-capacity that grasps wholes before conceptual division; functions as epistemological foundation enabling intuitive vision; provides Bhedabheda unity-emphasis perspective',
  `c_1_consciousness_structure`: 'Intuitive seeing consciousness - unified vision before thought; bhavana (felt-sense) level common to all beings; vivid apprehension of totality; corresponds to intuition-function in typology; svapna (dream state) quality',
  `c_1_description`: 'Pasyanti (from Sanskrit root "to see") represents visionary divine speech - consciousness that can be visualized but not yet verbalized. This is the level where Para Vak\'s undifferentiated unity begins to differentiate while maintaining non-dual seeing. In Kashmir Shaivism, Pasyanti is the stage where all objects are seen simultaneously as unity - like viewing an entire painting at once before focusing on particular elements. This seeing is common to all beings before language differences arise - Indians, Europeans, birds, beasts all experience the same bhavana (felt-sense) at this level. Has color and form (rupa) but lacks conceptual particularization. Seated at the navel/Manipura chakra. Corresponds to Bhedabheda philosophical position with unity emphasis - difference-in-unity where multiplicity is seen but as differentiation within single consciousness. In Para/Parapara/Apara sequence, this is First Parapara (Supreme-Non-Supreme) - unity moving toward differentiation while retaining supremacy. Pasyanti provides the unified vision that Madhyama will structure into thought and Vaikhari will articulate into speech.',
  `c_1_internal_structure`: 'Epistemological level - unified seeing before conceptualization; has color and form but not particularization; simultaneous grasping of multiplicity in unity; bhavana (felt-sense) common across all beings; seated at navel/Manipura chakra; vivid intuitive seeing',
  `c_1_key_principles`: ['Visionary Speech: Pasyanti as "that which can be seen" - consciousness visualizing but not yet verbalizing', 'Unified Vision: Seeing all simultaneously like viewing painting whole before examining parts', 'Pre-Linguistic: Common to all beings before language differences - universal bhavana (felt-sense)', 'Color and Form: Has rupa (form) but lacks conceptual particularization - visual but pre-verbal', 'Bhedabheda Unity-Emphasis: Seeing many within one - difference as differentiation of unity', 'First Parapara: Supreme-Non-Supreme movement - unity beginning to differentiate while retaining supremacy', 'Navel Seat: Chakra location at Manipura - solar plexus center of seeing-energy', 'Intuitive Grasping: Direct apprehension of wholes without discursive thought'],
  `c_1_name`: 'Pasyanti',
  `c_1_primary_designation`: 'First Parapara (Supreme-Non-Supreme) - Unity Differentiating Through Unified Vision',
  `c_1_structure`: 'Epistemological level - unified seeing before conceptualization; has color and form but not particularization; simultaneous grasping of multiplicity in unity; bhavana (felt-sense) common across all beings; seated at navel/Manipura chakra; vivid intuitive seeing',
  `c_2_architectural_function`: 'Establishes position #2 as epistemological foundation - how unified knowing occurs before conceptual division; provides the seeing-capacity that grasps wholes; functions as Bhedabheda with unity emphasis - seeing the many within the one; mediates between undifferentiated Para Vak and structured Madhyama',
  `c_2_epistemic_level`: 'Unified Seeing (Epistemology) - how we know when wisdom grasps wholes; intuitive vision before discursive analysis; foundation for Logical Lens #2-1-2 tetralemma "both" position',
  `c_2_kosha`: 'Vijnanamaya (Wisdom Sheath) - discriminating awareness',
  `c_2_notion_page_id`: '1d2a4797-123c-81a4-a1d5-eae788e3b611',
  `c_2_prophetic_function`: 'The level from which true vision emerges',
  `c_2_revelatory_cognition`: 'Direct knowing without sequential thought',
  `c_2_uuid`: 'c9959484-c67c-5559-9e61-f94bb6337304',
  `c_2_vak_level`: 'Pasyanti (Seeing Speech) - visionary level with color and form but not yet conceptual particularization; common to all beings before language differences; seated at navel/Manipura chakra; simultaneous unified seeing',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Whole-Seeing Practice: Viewing phenomena as unified wholes before analyzing parts', 'Pre-Verbal Awareness: Resting in felt-sense (bhavana) before language arises', 'Synoptic Vision: Grasping entire systems/fields simultaneously', 'Manipura Meditation: Working with solar plexus as seat of visionary seeing', 'Intuition Development: Cultivating direct apprehension without discursive thought', 'Unity-in-Difference Recognition: Seeing multiplicity as one consciousness differentiating', 'Etymology Seeing: Grasping semantic fields whole before particularizing meanings'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: [],
  `c_4_ql_position`: 2,
  `c_4_subsystem`: 2,
  `c_5_para_apara_correlation`: 'First Parapara (Supreme-Non-Supreme) - unity moving toward differentiation; Para quality retained while differentiation begins; Supreme becoming Non-Supreme while maintaining supremacy',
  `c_5_resonances`: ['Unified Field Theory: Physics seeking single vision encompassing all forces', 'Synesthesia: Cross-sensory perception as metaphor for pre-differentiated seeing', 'Nous: Plotinus\' divine intellect seeing all forms simultaneously', 'Prehension: Whitehead\'s feeling-tone before conceptual analysis', 'Imaginal Realm: Corbin\'s mundus imaginalis - neither sensory nor conceptual', 'First Parapara: Supreme-Non-Supreme movement in cosmological sequence', 'Tetralemma "Both": Logical Lens #2-1-2 position seeing unity-in-difference'],
  `coordinate_axis`: 'direct',
  `coordinate_parent`: 'L5',
  `l_0_base_index_6`: 5,
  `l_0_flat_index`: 32,
  `l_0_klein_square`: 'A',
  `l_0_lens_index_12`: 5,
  `l_0_position_index`: 2,
  `l_0_prior_dotted_coordinate`: 'L5.2',
  `m_2_1_prior_coordinate`: 'M2-1-5-2',
  `p_2_philosophical_position`: 'Bhedabheda (Difference-in-Unity) with Unity Emphasis - seeing the many within the one; recognizing multiplicity as differentiation of single consciousness; both-and logic operative; unity maintained through difference',
  `q_2_divine_archaeology_gesture`: 'The visionary realm where forms exist as unified wholes before fragmentation. Following the \'family\' of related words (cognates) back reveals their common Paśyantī vision - the single seeing that later crystallized into multiple words. The realm where \'all languages speak one truth.\'',
  `q_2_jnana_sakti_manifest`: 'Knowledge (Jñāna) in its intuitive form - not discursive thought but instantaneous grasping of wholes. The \'all-at-once\' knowing that precedes sequential understanding. Prajñā (wisdom) as direct insight. Seeing the end in the beginning, the oak in the acorn.',
  `q_2_prakasa_vimarsa`: 'Light differentiating within itself while maintaining unity. Vimarśa becoming specific - consciousness recognizing WHAT it might manifest, though not yet HOW or WHEN. The mirror showing infinite reflections simultaneously without confusion. Unity-in-diversity as direct vision.',
  `q_2_siva_sakti_play`: 'Śakti\'s seeing (Paśyantī = \'she who sees\') - consciousness surveying its infinite creative possibilities. Jñāna Śakti (Knowledge-Power) becoming active. Like an artist viewing their unmanifested vision whole before beginning to paint. The pregnant moment of total apprehension before particular creation.',
  `q_2_spanda_nature`: 'Throb intensifying into wave-patterns - spanda becoming sphuraṇā (flashing forth). The heartbeat differentiating into rhythms while maintaining its source-pulse. Like white light prismatically revealing colors yet remaining white. Vibration beginning to show its modal possibilities.',
  `sync_status`: 'm2_1_l_child_coordinate_syntax_corrected',
  `sync_version`: 'm2-1-l-child-coordinate-syntax-correction-2026-06-03'
};
MERGE (n:SynthesisAttribute {coordinate: 'L5-3'})
  SET n:MEFLens
  SET n += {
  `c_0_bedhabheda_nature`: 'Non-Supreme-cum-Supreme - difference recognizing unity',
  `c_0_core_nature`: 'Middle/mediating speech where unified vision structures itself into concepts and relationships; internal mental speech before external utterance; the bridge between seeing (Pasyanti) and speaking (Vaikhari); verbalized but unspoken thought, internal monologue and dialogue; where archetypes become thought-forms',
  `c_0_essence`: 'Operates as structuring-capacity organizing consciousness into thought-forms; functions as psychological foundation enabling symbolic operations; provides Bhedabheda difference-emphasis perspective',
  `c_0_operational_essence`: 'Operates as structuring-capacity organizing consciousness into thought-forms; functions as psychological foundation enabling symbolic operations; provides Bhedabheda difference-emphasis perspective',
  `c_1_consciousness_structure`: 'Internal mental speech consciousness - thought before utterance; svapna (dream state) quality where images and concepts flow; reflexive thinking that structures experience; corresponds to thinking-function in typology',
  `c_1_description`: 'Madhyama (from Sanskrit "middle") represents the mediating level of divine speech - internal mental speech that is verbalized but not yet uttered aloud. This is where Pasyanti\'s unified vision differentiates into concepts, thought-forms, internal dialogue, and mental structures. In Kashmir Shaivism, Madhyama is the stage where seeing becomes structured thinking - the internal monologue we all experience before speaking. Seated at the heart/Anahata chakra, this is the level of assertive intelligence coupled with syllables (a, ka, cha, tha, ta, pa...). Corresponds to svapna (dream state) consciousness where images and thoughts flow. Philosophically represents Bhedabheda with difference emphasis - unity-in-difference where we recognize the one through the many, seeing how diversity patterns toward unity. In Para/Parapara/Apara sequence, this is Second Parapara (Non-Supreme-Supreme) - difference moving toward unity through structural recognition. Madhyama is crucial mediator: without it, Pasyanti vision could not become Vaikhari articulation. It provides the psychological structures (concepts, categories, relationships) that enable manifest speech.',
  `c_1_internal_structure`: 'Psychological level - internal structuring of consciousness; mental speech before external utterance; internal dialogue and monologue; thought-forms and conceptual structures; seated at heart/Anahata chakra; svapna (dream) consciousness; syllabic intelligence (varnas)',
  `c_1_key_principles`: ['Mediating Speech: Madhyama as middle ground between seeing (Pasyanti) and speaking (Vaikhari)', 'Internal Dialogue: Verbalized but unspoken thought - the internal monologue all beings experience', 'Mental Structuring: Where unified vision differentiates into concepts, categories, relationships', 'Heart Seat: Chakra location at Anahata - heart center of thought-forming', 'Syllabic Intelligence: Assertive intelligence coupled with syllables (a, ka, cha, tha...)', 'Bhedabheda Difference-Emphasis: Seeing the one through the many - diversity patterning toward unity', 'Second Parapara: Non-Supreme-Supreme movement - difference moving toward unity through structure', 'Psychological Foundation: Where thought-forms enable symbolic operations and conceptual processing'],
  `c_1_name`: 'Madhyama',
  `c_1_primary_designation`: 'Second Parapara (Non-Supreme-Supreme) - Difference Unifying Through Internal Dialogue',
  `c_1_structure`: 'Psychological level - internal structuring of consciousness; mental speech before external utterance; internal dialogue and monologue; thought-forms and conceptual structures; seated at heart/Anahata chakra; svapna (dream) consciousness; syllabic intelligence (varnas)',
  `c_2_architectural_function`: 'Establishes position #3 as psychological foundation - how consciousness structures itself through symbolic operations; provides the mediating level between unified seeing and manifest speaking; functions as Bhedabheda with difference emphasis - recognizing how diversity patterns itself toward unity; transforms Pasyanti vision into mental structures that Vaikhari can articulate',
  `c_2_epistemic_level`: 'Internal Structuring (Psychology) - how consciousness becomes self-aware through symbolic operations; how the knower knows itself; foundation for Processual Lens #2-1-3 integration stage',
  `c_2_kosha`: 'Manomaya (Mental Sheath) - conceptual elaboration',
  `c_2_linguistic_bridge`: 'Where meaning crystallizes into mental language',
  `c_2_mediating_level`: 'Bridges unified vision (Pasyanti) and manifest expression (Vaikhari)',
  `c_2_notion_page_id`: '1d2a4797-123c-8125-9de5-fbce5966f4ce',
  `c_2_uuid`: 'd663cd3b-dcd4-5b4e-9a06-1463f4443c85',
  `c_2_vak_level`: 'Madhyama (Mediating Speech) - middle level between seeing and speaking; internal mental speech verbalized but unspoken; seated at heart/Anahata chakra; assertive intelligence with syllables; dream-like thought flow',
  `c_3_context_frame`: '0000',
  `c_3_dataset_branch`: 'parashakti-deep',
  `c_3_dataset_branch_label`: 'M2 Parashakti Deep',
  `c_3_practical_applications`: ['Thought-Watching: Observing internal dialogue as Madhyama level operating', 'Conceptual Structuring: Organizing intuitions into coherent thought-forms', 'Anahata Meditation: Working with heart chakra as seat of structured thought', 'Internal Rehearsal: Using mental speech to structure before external expression', 'Syllable Awareness: Recognizing how sounds (varnas) structure meaning internally', 'Unity-Through-Difference: Seeing how conceptual distinctions enable recognition of unity', 'Etymology Structuring: Tracing how unified semantic visions structure into particular concepts'],
  `c_3_source_dataset`: 'bimba',
  `c_4_family`: 'L',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_category`: 'implicate',
  `c_4_ql_operator_types`: [],
  `c_4_ql_position`: 3,
  `c_4_subsystem`: 2,
  `c_5_para_apara_correlation`: 'Second Parapara (Non-Supreme-Supreme) - difference moving toward unity; Non-Supreme becoming Supreme through structural recognition; diversity patterning toward wholeness',
  `c_5_resonances`: ['Internal Dialogue: Psychology\'s recognition of inner speech structuring thought', 'Symbolic Order: Lacan\'s level where meaning structures through language', 'Conceptual Prehension: Whitehead\'s how of feeling - structuring what is felt', 'Logos: Greek divine reason organizing cosmos through logical structures', 'Second Parapara: Non-Supreme-Supreme in cosmological sequence', 'Tetralemma Synthesis: Logical Lens #2-1-2 recognition of unity through difference', 'Svapna: Dream consciousness where thoughts flow without external manifestation'],
  `coordinate_axis`: 'direct',
