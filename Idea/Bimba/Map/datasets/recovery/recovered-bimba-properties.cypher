MATCH (n:Bimba {coordinate: 'S2'}) SET n += {
  `artifact_kind`: 'vault_markdown',
  `c_0_core_nature`: 'Neo4j coordinate graph, schema validation, typed relations, retrieval, and promotion materialization authority.',
  `c_1_description`: 'Neo4j raw storage; coordinate-forward node and relation schema; embedding substrate; chunk ingestion',
  `c_1_form`: 'Idea/Bimba/World/Types/Coordinates/S/S2/S2.md',
  `c_1_name`: 'Neo4j',
  `c_1_prior_description`: 'Neo4j coordinate graph, schema validation, typed relations, retrieval, and promotion materialization authority.',
  `c_1_prior_name`: 'Neo4j',
  `c_1_structure`: '{"authority_spec":"docs/specs/S/S2-S2i-GRAPH.md","layer_name":"graphdb","promotion_contract":"s-branch-live-promotion-v1"}',
  `c_4_artifact_role`: 'definition',
  `c_4_inversion_state`: 0,
  `c_4_ql_position`: 2,
  `content_hash`: 'sha256:74aa7d899d7dbfd33e981eccb2478505189751caa21ee35ef192b8ef9369b143',
  `coordinate_axis`: 'direct',
  `coordinate_depth`: 1,
