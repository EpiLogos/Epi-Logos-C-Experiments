MATCH (n:Bimba {coordinate: 'M0-3-11'}) SET n += {
  `c_0_adam_eve_classification`: 'Adam (Structural Contemplation)',
  `c_0_archetypal_correspondence`: 'Hod (Splendor) - the intellect and rational thought made self-aware; the Buddha\'s realization of the emptiness of all conditioned existence',
  `c_0_architectural_metaphor`: 'The perfect cathedral that, upon completion, stands empty and questions what Being might inhabit it, recognizing its own essential emptiness.',
  `c_0_consciousness_function`: 'The capacity for consciousness to turn back upon itself and question its own nature, even in states of apparent perfection and completion.',
  `c_0_emptiness_realization`: 'The Buddhist insight that even the most perfect and complete structures are ultimately empty of inherent existence, dependently arisen and impermanent.',
  `c_0_existential_query`: 'Sat? (Being?) - the ultimate question that arises when perfect form contemplates its own nature and discovers its essential emptiness',
  `c_0_operational_dynamics`: 'Operates through the doubling of the Primordial Matrix (2x(##)) and its interaction with Reality principles. The fundamental process is structure reflecting upon structure, form contemplating form, leading to the ultimate existential question "Sat?" (What is Being?).',
  `c_0_operational_essence`: 'Functions as the "Emptiness of Fullness" - the recognition that even the most perfect, stable structures are ultimately empty of inherent existence. The anabolic process that builds perfect form only to have it question its own nature through the fundamental inquiry "Sat?" (Being?).',
  `c_0_quality`: 'Purnata-Sunyata (Emptiness of Fullness)',
  `c_1_metaphysical_names`: 'Purnata-Sunyata, The Emptiness of Fullness, The Empty Throne, Structural Reflection, Sat?, The Doubled Cathedral, The Question of Being',
  `c_1_symbol`: '8',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_variant`: '11/12 - mod12',
  `c_4_subsystem`: 0,
  `c_5_octave_relationship`: 'The higher octave of 4, demonstrating how the same principles manifest at different levels of complexity and self-awareness.'
};
MATCH (n:Bimba {coordinate: 'M0-3-2'}) SET n += {
  `c_0_adam_eve_classification`: 'Neither - Transcendent Root',
  `c_0_archetypal_correspondence`: 'Ain Soph Aur (Limitless Light) - transcendent potential before creation; Kether\'s pre-manifestation aspect',
