MATCH (n:Bimba {coordinate: 'M3-1-2-0'}) SET n += {
  `c_1_chinese_name`: '無妄',
  `c_1_english_name`: 'Innocence / The Unexpected',
  `c_1_keywords`: ['Acting Naturally', 'Spontaneity', 'Inner Truth', 'Alignment with Heaven', 'Unexpected Events', 'Freedom from Motives', 'Correctness', 'Integrity', 'Potential Misfortune'],
  `c_1_line_texts`: ['Innocent behavior brings good fortune.', 'If one does not count on the harvest while plowing, nor on the use of the ground while clearing it.', 'Undeserved misfortune. The cow that was tethered by someone is the wanderer\'s gain, the citizen\'s loss.', 'He who can be persevering remains without blame.', 'Use no medicine in an illness incurred through no fault of your own. It will pass of itself.', 'Innocent action brings misfortune. Nothing furthers.'],
