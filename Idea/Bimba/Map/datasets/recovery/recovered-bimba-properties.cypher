MATCH (n:Bimba {coordinate: 'M0-3-9'}) SET n += {
  `c_0_adam_eve_classification`: 'Adam (Structural Resolution)',
  `c_0_archetypal_correspondence`: 'Tiphareth (Beauty) - the heart of the Tree of Life, the point of perfect balance and synthesis where all paths converge',
  `c_0_beauty_principle`: 'The recognition that true beauty lies not in complex ornamentation but in the simple, elegant resolution of complexity into essential emptiness.',
  `c_0_consciousness_function`: 'The capacity for consciousness to recognize that all complexity and manifestation ultimately resolves back into the simple, fertile emptiness from which it arose.',
  `c_0_metabolic_function`: 'The exhalation phase of the cosmic breath, the systolic process that returns the manifest back to the unmanifest for renewal and regeneration.',
  `c_0_operational_dynamics`: 'Operates through a complex series of interactions between positive (+), negative (-), and Presence (@) principles. The crucial recognition is that all pathways lead to the same destination: 00, the foundational void from which all emerged.',
  `c_0_operational_essence`: 'Functions as the alchemical process where complex manifestation (Purnata) reveals its essential emptiness (Sunyata) through conscious resolution back to the 00 Void. The catabolic process that balances the anabolic building of the earlier numbers.',
  `c_0_quality`: 'Sunyata-Purnata (Fullness of Emptiness)',
  `c_1_metaphysical_names`: 'Sunyata-Purnata, The Fullness of Emptiness, Cosmic Exhalation, The Solve Process, Catabolic Resolution, The Return',
  `c_1_symbol`: '6',
  `c_4_layer`: 'COORDINATE',
  `c_4_ql_variant`: '11/12 - mod12',
  `c_4_subsystem`: 0
