MATCH (n:Bimba {coordinate: 'M0-4.(5/0)-3'}) SET n += {
  `c_0_becoming_father`: 'Demonstrates the non-dual recognition: Adam IS both Son and Father. The 2 emerges from four-fold zero but establishes foundation for 4. The 4 inherits from 2 but grounds 6. Not linear descent but recursive founding - simultaneously child and parent, receiver and giver.',
  `c_0_coordinate_value`: '3/3-',
