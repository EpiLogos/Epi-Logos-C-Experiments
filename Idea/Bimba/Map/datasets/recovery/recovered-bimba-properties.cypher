  `c_3_nuclear_dynamics`: 'Fire over Wind nuclear reveals that limitation creates the cauldron - necessary boundaries enable sacred transformation.',
  `c_3_physical_manifestations`: ['Regulated expression', 'Bounded pleasure', 'Sustainable joy', 'Kidney-regulated speech', 'Measured communication', 'Balanced expression', 'Structured pleasure'],
  `c_3_social_applications`: ['Brother limiting sister', 'Family boundaries', 'Regulated joy', 'Necessary limitations', 'Family discipline', 'Structured expression', 'Balanced freedom'],
  `c_3_social_role`: ['Middle Son over Youngest Daughter', 'Setting boundaries'],
  `c_3_social_role_dynamics`: 'Youngest Daughter (lake/excessive joy) limited by Middle Son (water/deep regulation) - Brother\'s depth creating necessary boundaries for sister\'s expression.',
  `c_4_layer`: 'COORDINATE',
  `c_4_subsystem`: 3,
  `l_3_body_dynamics`: 'Mouth/Chest limited by Kidneys/Ears - Joyful expression regulated by deep wisdom, where kidney essence creates necessary boundaries for sustainable pleasure.',
  `l_3_body_part`: ['Kidneys/Ears (Water)', 'Mouth/Chest (Lake)'],
  `t_3_season`: 'Winter (Water) over Autumn (Lake)',
