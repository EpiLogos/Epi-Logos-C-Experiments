  `c_3_moc_evidence_paths`: ['Idea/Bimba/World/Types/Coordinates/C/C1/C1.canvas', 'Idea/Bimba/World/Types/Coordinates/C/C1/C1.md'],
  `c_4_artifact_role`: 'type-moc-pointer',
