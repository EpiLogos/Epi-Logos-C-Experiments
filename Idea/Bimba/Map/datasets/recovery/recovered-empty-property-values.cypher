MATCH (n:Bimba {coordinate: 'M2-5-(0/1)'}) WHERE n.`c_2_inner_offering` = '' SET n.`c_2_inner_offering` = 'Recognition of one\'s own awareness as solar - sacrificing the illusion of darkness/ignorance to the ever-present light of consciousness';
