coordinate: "CT0"
c_4_artifact_role: "base-view"
c_1_ct_type: "CT0"
c_5_reflects: "[[CT0]]"
c_0_source_coordinates: ["[[CT0]]", "[[CT]]", "[[C5]]"]
filters:
  or:
    - 'c_1_ct_type == "CT0"'
    - 'ctx_type == "CT0"'
    - 'c_1_ctx_type == "CT0"'
views:
  - type: table
    name: "Day intake stream"
    group_by: c_4_artifact_role
    order:
      - coordinate
      - c_4_artifact_role
      - c_3_ctx_frame
      - c_3_day_id
      - c_3_created_at
      - c_0_source_coordinates
      - p0_grounds
      - p0_adjacencies
    sort:
      - { property: c_3_created_at, direction: DESC }
      - { property: coordinate, direction: ASC }
  - type: table
    name: "Open ground needing definition"
    filters:
      and:
        - 'c_5_reflection_complete == false'
    order:
      - coordinate
      - c_4_artifact_role
      - c_3_created_at
      - p0_grounds
      - p0_adjacencies
      - c_0_source_coordinates
