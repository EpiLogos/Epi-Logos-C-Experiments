  "MathemeHarmonicProfileBoundary": {
    "payloadNarrowingExamples": [
      {
        "field": "kleinFlip",
        "consumer": "m2-parashakti",
        "payloadPath": "payload.kleinFlip",
        "narrowing": "Treat as an object-valued profile event; when `kind` is `m2CymaticValenceInvert`, M2 renders inverted surface valence, otherwise primary.",
        "examplePayload": {
          "kleinFlip": {
            "kind": "m2CymaticValenceInvert",
            "source": "profile.kleinFlip"
          }
        },
        "fallback": "If absent, M2 reports `pending-kleinFlip` and keeps primary surface valence."
      },
      {
        "field": "anuttaraWitness",
        "consumer": "m0-anuttara",
        "payloadPath": "payload.anuttaraWitness",
        "narrowing": "Treat as an emit-only typed witness projection with 9-bit virtue vector, 4-bit syntax vector, read-only R-factor path, band balance, palindrome state, open Law-6 questions, and coherence score. Consumers may render or learn from it but must not gate readiness on its presence.",
        "examplePayload": {
          "anuttaraWitness": {
            "virtueWitnessVector": 453,
            "syntaxWitnessVector": 9,
            "rfactorPath": [
              {
                "rFactor": 1,
                "baseRoute": "Nara",
                "band": "pravritti",
                "position": 4,
                "isTurn": false
              },
              {
                "rFactor": 2,
                "baseRoute": "Shakti",
                "band": "pravritti",
                "position": 5,
                "isTurn": true
              },
              {
                "rFactor": 3,
                "baseRoute": "Shakti",
                "band": "nivritti",
                "position": 0,
                "isTurn": false
              }
            ],
            "bandBalance": {
              "pravrittiDepth": 2,
              "nivrittiDepth": 1,
              "reachedTurn": true,
              "returned": false
            },
            "palindromeState": {
              "normalFormSymmetric": false,
              "mirrorNormalForm": "R1@Nara/4|(@#)|R3@Shakti/0"
            },
            "openQuestions": [
              "Law-6:R3@Shakti:return?"
            ],
            "coherenceScore": 0.625
          }
        },
        "fallback": "If absent, M0 reports `pending-anuttaraWitness` as informational/degraded evidence only; only the human gate and M5 review may block."
      }
    ],
    "rule": "The bridge keeps `payload` opaque at the shared boundary; each M-extension narrows only the fields declared by its contract and readiness checks."
  },
