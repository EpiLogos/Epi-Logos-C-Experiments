{
  "name": "@pratibimba/m0-anuttara",
  "version": "0.1.0",
  "description": "m0-anuttara M-extension scaffold. First-slice priority: Anuttara language-map browser plus OWL/SHACL provenance inspector backed by bridge-mediated S2 graph queries.",
