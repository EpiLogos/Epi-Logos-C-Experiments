  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module"
    }
  ],
  "keywords": [
    "theia-extension",
    "epi-logos",
    "m-extension",
    "m0-anuttara"
  ],
  "dependencies": {
