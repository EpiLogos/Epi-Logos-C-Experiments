{
  "name": "@pratibimba/m4-nara",
  "version": "0.1.0",
  "description": "m4-nara M-extension scaffold. First-slice priority: Protected Nara DayContainer and Graphiti browser with handle-only deep links and explicit consent/privacy gates.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "style"
  ],
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module"
    }
  ],
  "keywords": [
    "theia-extension",
    "epi-logos",
    "m-extension",
    "m4-nara"
  ],
  "dependencies": {
    "@tiptap/core": "^3.20.0",
    "@tiptap/extension-placeholder": "^3.20.0",
    "@tiptap/react": "^3.20.0",
    "@tiptap/starter-kit": "^3.20.0",
    "@theia/core": "1.56.0",
    "@pratibimba/integrated-composition": "workspace:*",
    "@pratibimba/m-extension-runtime": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "build": "pnpm -C ../.. exec tsc -b extensions/m4-nara",
    "watch": "tsc -b -w",
    "clean": "rimraf lib",
    "test": "pnpm build && node --test tests/privacy-chrome.test.mjs tests/symbolic-protein-reading.test.mjs ../test/m4-nara-canvas-editor.test.mjs ../test/m4-nara-kairos-display.test.mjs ../test/m4-nara-mercurius-relay-indicator.test.mjs ../test/m4-nara-e4-personal-energy.test.mjs ../test/m4-nara-journal-entries-sidebar.test.mjs ../test/m4-nara-pasu-wizard.test.mjs ../test/m4-nara-quintessence-display.test.mjs ../test/m4-nara-dialogical-arena.test.mjs"
  }
}
