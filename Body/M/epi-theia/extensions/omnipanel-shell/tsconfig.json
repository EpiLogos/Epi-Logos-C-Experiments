{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@pratibimba/integrated-composition": ["../integrated-composition/lib/common/index.d.ts"],
      "@pratibimba/m-extension-runtime": ["../m-extension-runtime/src/common"]
    },
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false
  },
  "references": [
    { "path": "../ide-shell-m0-m5" },
    { "path": "../block-kit" },
    { "path": "../m-extension-runtime" },
    { "path": "../pratibimba-layouts" }
  ],
  "include": ["src"]
}
