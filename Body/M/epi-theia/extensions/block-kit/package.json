  "files": ["lib", "src", "style"],
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module"
    }
  ],
  "keywords": ["theia-extension", "epi-logos", "block-kit", "pratibimba"],
  "dependencies": {
    "@theia/core": "1.56.0",
