{
  "name": "@pratibimba/integrated-composition",
  "version": "0.1.0",
  "description": "Shared composition coordinator for Track 08 integrated plugins. Owns LayoutClaim arbitration, named layout descriptors, IntegratedReadiness aggregation, and the empty-state contract consumed by plugin-integrated-1-2-3 and plugin-integrated-4-5-0. Track 08 T1.",
  "license": "MIT",
  "files": ["lib", "src", "style"],
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/common/index.d.ts",
      "default": "./lib/common/index.js"
    },
    "./recursive-self-review-gate": {
      "types": "./lib/common/recursive-self-review-gate.d.ts",
      "default": "./lib/common/recursive-self-review-gate.js"
    },
    "./epii-review-state": {
      "types": "./lib/common/epii-review-state.d.ts",
      "default": "./lib/common/epii-review-state.js"
    },
    "./integrated-readiness": {
      "types": "./lib/common/integrated-readiness.d.ts",
      "default": "./lib/common/integrated-readiness.js"
    },
    "./graphiti-source-guard": {
      "types": "./lib/common/graphiti-source-guard.d.ts",
      "default": "./lib/common/graphiti-source-guard.js"
    },
    "./integrated-deep-links": {
      "types": "./lib/common/integrated-deep-links.d.ts",
      "default": "./lib/common/integrated-deep-links.js"
    },
    "./recognition-claim": {
      "types": "./lib/common/recognition-claim.d.ts",
      "default": "./lib/common/recognition-claim.js"
    },
    "./design-primitives": {
      "types": "./lib/browser/design-primitives/index.d.ts",
      "default": "./lib/browser/design-primitives/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "design-primitives": ["lib/browser/design-primitives/index.d.ts"],
      "recursive-self-review-gate": ["lib/common/recursive-self-review-gate.d.ts"],
      "epii-review-state": ["lib/common/epii-review-state.d.ts"],
      "integrated-readiness": ["lib/common/integrated-readiness.d.ts"],
      "graphiti-source-guard": ["lib/common/graphiti-source-guard.d.ts"],
      "integrated-deep-links": ["lib/common/integrated-deep-links.d.ts"],
      "recognition-claim": ["lib/common/recognition-claim.d.ts"]
    }
  },
  "keywords": ["theia-extension", "epi-logos", "integrated-plugin", "composition"],
  "dependencies": {
    "@theia/core": "1.56.0",
    "@pratibimba/m-extension-runtime": "workspace:*",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test": "pnpm clean && pnpm build && node --test tests/*.test.mjs"
  }
}
