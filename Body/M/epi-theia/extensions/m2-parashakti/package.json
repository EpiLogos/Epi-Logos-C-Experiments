{
  "name": "@pratibimba/m2-parashakti",
  "version": "0.1.0",
  "description": "m2-parashakti M-extension scaffold. First-slice priority: M2PrimeMeaningPacket viewer plus deterministic cymatic renderer driven by profile bus and proven correspondence payloads.",
  "license": "MIT",
  "files": [
    "lib",
    "src",
    "style"
  ],
  "main": "lib/common/index.js",
  "types": "lib/common/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/common/index.d.ts",
      "default": "./lib/common/index.js"
    },
    "./meaning-packet": {
      "types": "./lib/common/meaning-packet.d.ts",
      "default": "./lib/common/meaning-packet.js"
    },
    "./common/composition": {
      "types": "./lib/common/composition.d.ts",
      "default": "./lib/common/composition.js"
    }
  },
  "typesVersions": {
    "*": {
      "meaning-packet": ["lib/common/meaning-packet.d.ts"],
      "common/composition": ["lib/common/composition.d.ts"]
    }
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/frontend-module"
    }
  ],
  "keywords": [
    "theia-extension",
    "epi-logos",
    "m-extension",
    "m2-parashakti"
  ],
  "dependencies": {
    "@theia/core": "1.56.0",
    "@pratibimba/integrated-composition": "workspace:*",
    "@pratibimba/m-extension-runtime": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "rimraf": "^5.0.5",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b -w",
    "clean": "rimraf lib tsconfig.tsbuildinfo",
    "test:outer-planet-pending": "node --test test/outer-planet-pending.test.mjs",
    "test:shadow-decan": "node --test test/shadow-decan.test.mjs",
    "test:audio-bus-visual": "node --test test/audio-bus-visual.test.mjs",
    "test:provenance-inline": "node --test test/provenance-inline.test.mjs",
    "test:cymatic-transport": "node --test test/cymatic-transport.test.mjs",
    "test:cymatic-determinism": "node --test test/cymatic-determinism.test.mjs",
    "test:cymatic-spheres-deferred": "node --test test/cymatic-spheres-deferred.test.mjs",
    "test": "node --test test/widget-registry.test.mjs && node --test test/shadow-decan.test.mjs && node --test test/audio-bus-visual.test.mjs && node --test test/provenance-inline.test.mjs && node --test test/cymatic-transport.test.mjs && node --test test/cymatic-determinism.test.mjs && node --test test/cymatic-spheres-deferred.test.mjs && pnpm build"
  }
}
