  "context_assembly": {
    "method": "s4'.context.assemble",
    "coordinate_owner": "S4'",
    "tranche": "51.T51.1",
    "assembler": "Body/S/S4/ta-onta/spine/compositor.ts::SpineCompositor.assembleContextPack",
    "published_to": "<gate-state-root>/s4/context-pack/<session-slug>.json",
    "served_by": "Body/S/S0/epi-cli/src/gate/anima.rs::context_assemble",
    "single_assembler_law": "The S4' spine compositor assembles ONCE per session: it injects pack.injection as the session system prompt and publishes that same object. The gateway adapter READS the published pack and never re-assembles - two code paths that both assemble the pack is how the injection drifted into being dead with nothing able to notice.",
    "returns": ["owner", "sessionKey", "present", "assembler", "packPath", "pack"],
    "pack_fields": ["version", "sessionKey", "assembledAtMs", "budget", "blocks", "injection"],
    "block_fields": ["coordinate", "cost", "status", "bytes", "charEstimate", "producedAtMs", "rendered", "vakToken", "error"],
    "entitlement_class": "standard",
    "is_dispatch_tool": false,
    "dispatch_tool_note": "A gateway METHOD, not a vak-dispatch tool: it is deliberately absent from dispatch_tools so capability-parity's local and gateway tool sets stay identical."
  },
  "orchestration_run": {
    "method": "s4'.orchestration.score",
    "coordinate_owner": "S4'",
    "tranche": "50.T50.10",
    "composer": "Body/S/S4/ta-onta/S4-4p-anima/lib/vak-orchestration-surface.ts::defineOrchestration/runOrchestration",
    "persisted_by": "Body/S/S4/ta-onta/S4-1p-hen/modules/score-store.ts::saveScore/recordScoreRun",
    "published_to": "<EPI_SCORES_DIR or repo-root>/.epi/scores/<scoreId>.json + <scoreId>.runs.jsonl",
    "served_by": "Body/S/S0/epi-cli/src/gate/anima.rs::orchestration_score",
    "reader_not_runner_law": "The adapter SERVES a persisted score and its run history; it never executes one. Pi->subagent is the only agentic path, so a gateway that ran orchestrations would be a second one, and run state belongs to the parent Anima session that holds it (S4-4p-anima/lib/orchestration-run.ts), not to a stateless RPC. Same reader discipline as s4'.context.assemble: the S4' authority produces, the S0 adapter serves what was produced.",
    "returns": ["owner", "scoreId", "present", "store", "authority", "hash", "score", "runs"],
    "returns_without_score_id": ["owner", "store", "authority", "scores"],
    "score_fields": ["schema", "id", "title", "provenance", "program", "hash"],
    "run_fields": ["scoreId", "hash", "at", "origination", "outcome", "detail"],
    "fails_closed_on": "a persisted score carrying no hash — a caller reading a program without the hash it was scored under cannot tell whether it is the program that ran",
    "entitlement_class": "standard",
    "is_dispatch_tool": false,
    "dispatch_tool_note": "A gateway METHOD, not a vak-dispatch tool: it is deliberately absent from dispatch_tools so capability-parity's local and gateway tool sets stay identical."
  },
